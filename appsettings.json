{
  "IncidentManagementKusto": {
    "ClusterUri": "https://icmcluster.kusto.windows.net",
    "Database": "IcmDataWarehouse",
    "QueryTimeoutSeconds": 180
  },
  "ReportExport": {
    "WorkItems": {
      "MaxCollectionBytes": 536870912
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
