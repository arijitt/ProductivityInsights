                    <option value="A365\Job Service V2" disabled="@(!IsAreaPathApplicable("A365\\Job Service V2"))">A365\Job Service V2</option>
                    <option value="A365\Trident\DE_DevE\Lakehouse Platform\Lakehouse Job Execution and Capacities" disabled="@(!IsAreaPathApplicable("A365\\Trident\\DE_DevE\\Lakehouse Platform\\Lakehouse Job Execution and Capacities"))">A365\Trident\DE_DevE\Lakehouse Platform\Lakehouse Job Execution and Capacities</option>
                </select>
            </div>
        }

        <div class="datetime-group mb-4">
            <div class="row">
                <div class="col-md-6 mb-3 mb-md-0">
                    <label for="startDateTime" class="form-label">Start Date Time</label>
                    <div class="datetime-input-wrapper">
                        <input type="datetime-local" id="startDateTime" class="form-control" @bind="startDateTime" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label for="endDateTime" class="form-label">End Date Time</label>
                    <div class="datetime-input-wrapper">
                        <input type="datetime-local" id="endDateTime" class="form-control" @bind="endDateTime" />
                    </div>
                </div>
            </div>
        </div>

        @if (selectedView == "trends")
        {
            <div class="datetime-group mb-4">
                <div class="row">
                    <div class="col-md-12">
                        <div class="datetime-input-wrapper">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="trendIntervalWI" id="trendYearlyWI" value="yearly" checked="@(selectedTrendPeriod == "yearly")" @onchange="@(() => selectedTrendPeriod = "yearly")" />
