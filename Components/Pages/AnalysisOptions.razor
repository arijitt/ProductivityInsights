    private void OnOptionSelected(string option)
    {
        // Close analysis results only if switching to a different tab type
        if (selectedOption != option)
        {
            CloseAnalysisResults();
            selectedOption = option;
            
            // Restore cached results if available for the new tab
            if (cachedResults.TryGetValue(option, out var cached))
            {
                contributors = cached.Contributors;
                contributorDetails = cached.Details;
                expandedRows = cached.ExpandedRows;
                analysisResultHtml = option;
            }
        }
    }

    private void OnTeamChanged(ChangeEventArgs e)
    {
        selectedTeam = e.Value?.ToString() ?? "Cosmos on Azure Job Service";
        selectedAreaPath = GetAreaPathForTeam();
    }

    private void OnOrganizationChanged(ChangeEventArgs e)
    {
        selectedOrganization = e.Value?.ToString() ?? "msdata";
        selectedProject = selectedOrganization == "msdata" ? "A365" : "MWC";
        if (selectedProject == "A365")
        {
            selectedTeam = "Cosmos on Azure Job Service";
            selectedGitRepository = "BBC-VHD";
            selectedAreaPath = GetAreaPathForTeam();
        }
        else if (selectedProject == "MWC")
        {
            selectedGitRepository = "workload-sparkcore";
        }
        selectedTargetBranch = GetTargetBranch();
    }

    private void OnProjectChanged(ChangeEventArgs e)
    {
        selectedProject = e.Value?.ToString() ?? "A365";
        if (selectedProject == "A365")
        {
            selectedTeam = "Cosmos on Azure Job Service";
            selectedGitRepository = "BBC-VHD";
        }
        else if (selectedProject == "HDInsight")
        {
            selectedGitRepository = "wildfire-livy";
        }
        else if (selectedProject == "MWC")
        {
            selectedGitRepository = "workload-sparkcore";
        }
        selectedTargetBranch = GetTargetBranch();
    }

    private void OnGitRepositoryChanged(ChangeEventArgs e)
    {
        selectedGitRepository = e.Value?.ToString() ?? "BBC-VHD";
        selectedTargetBranch = GetTargetBranch();
    }

    private string GetTargetBranch()
    {
        // Repositories that use "main" branch
        var mainBranchRepos = new[] { "workload-sparkcore", "workload-lakehouse", "workload-genericcomputemanager", 
                                      "workload-vpaas", "fabric-libraries", "fabric-spark-load-testing-suite", 
                                      "SparkRuntimeTSGs", "nebula" };
        
        // Repositories that use "master" branch
        var masterBranchRepos = new[] { "FeatureManagement", "aspaas", "wildfire-livy", 
                                        "BBC-VHD", "BBC-Probes", "marlin" };
        
        if (mainBranchRepos.Contains(selectedGitRepository))
        {
            return "main";
        }
        else if (masterBranchRepos.Contains(selectedGitRepository))
        {
            return "master";
        }
        
        return "main"; // default
    }

    private bool IsMainBranchApplicable()
    {
        var mainBranchRepos = new[] { "workload-sparkcore", "workload-lakehouse", "workload-genericcomputemanager", 
                                      "workload-vpaas", "fabric-libraries", "fabric-spark-load-testing-suite", 
                                      "SparkRuntimeTSGs", "nebula" };
        return mainBranchRepos.Contains(selectedGitRepository);
    }

    private bool IsMasterBranchApplicable()
    {
        var masterBranchRepos = new[] { "FeatureManagement", "aspaas", "wildfire-livy", 
                                        "BBC-VHD", "BBC-Probes", "marlin" };
        return masterBranchRepos.Contains(selectedGitRepository);
    }

    private string GetAreaPathForTeam()
    {
        return selectedTeam switch
        {
            "Cosmos on Azure Job Service" => "A365\\Cosmos Analytics\\Platforms\\Cosmos on Azure",
            "FastSpark" => "A365\\FastSpark",
            "JS Reliability" => "A365\\JS Reliability",
            "Job Service V2" => "A365\\Job Service V2",
            "Lakehouse Job Execution and Capacities" => "A365\\Trident\\DE_DevE\\Lakehouse Platform\\Lakehouse Job Execution and Capacities",
            _ => "A365\\Trident\\DE_DevE\\Lakehouse Platform\\Lakehouse Job Execution and Capacities"
        };
    }

    private bool IsAreaPathApplicable(string areaPath)
    {
        return GetAreaPathForTeam() == areaPath;
    }

    private async Task ProcessAnalysis()
    {
        analysisParameters = BuildAnalysisParametersHtml();
        analysisResultHtml = string.Empty;
        await JSRuntime.InvokeVoidAsync("showModal", "analysisModal");
    }

    private WorkItemQueryOptions GetWorkItemQueryOptions()
    {
        return new WorkItemQueryOptions
        {
            OrganizationName = selectedOrganization,
            ProjectName = selectedProject,
            TeamName = selectedTeam,
            AreaPath = selectedAreaPath,
            StartDateTime = startDateTime,
            EndDateTime = endDateTime
        };
    }

    private CommitQueryOptions GetCommitQueryOptions()
    {
        return new CommitQueryOptions
        {
            OrganizationName = selectedOrganization,
            ProjectName = selectedProject,
            GitRepositoryName = selectedGitRepository,
            TargetBranchName = selectedTargetBranch,
            StartDateTime = startDateTime,
            EndDateTime = endDateTime
        };
    }

    private IncidentQueryOptions GetIncidentQueryOptions()
    {
        return new IncidentQueryOptions
        {
            OwningTeam = selectedOwningTeam,
            KeyVaultUrl = selectedKeyVaultUrl,
            KeyVaultCertificateName = selectedKeyVaultCertificateName,
            StartDateTime = startDateTime,
            EndDateTime = endDateTime
        };
    }

    private string BuildAnalysisParametersHtml()
    {
        var html = new System.Text.StringBuilder();
        html.Append("<div class='parameter-section'>");
        html.Append($"<h6 class='fw-bold text-primary mb-3'>Analysis Type: {GetAnalysisTypeName()}</h6>");
        
        html.Append("<table class='table table-sm table-bordered'>");
        html.Append("<tbody>");
        
        // Common parameters
        if (selectedOption != "icmResolutions")
        {
            html.Append($"<tr><td class='fw-bold' style='width: 200px;'>Organization</td><td>{selectedOrganization}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Project</td><td>{selectedProject}</td></tr>");
        }
        
        // Work Items specific
        if (selectedOption == "workItems")
        {
            if (selectedProject == "A365")
            {
                html.Append($"<tr><td class='fw-bold'>Team Name</td><td>{selectedTeam}</td></tr>");
            }
            html.Append($"<tr><td class='fw-bold'>Area Path</td><td>{selectedAreaPath}</td></tr>");
        }
        
        // Git Commits specific
        if (selectedOption == "gitCommits")
        {
            html.Append($"<tr><td class='fw-bold'>Git Repository</td><td>{selectedGitRepository}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Target Branch</td><td>{selectedTargetBranch}</td></tr>");
        }
        
        // ICM Resolutions specific
        if (selectedOption == "icmResolutions")
        {
            html.Append($"<tr><td class='fw-bold'>Owning Team</td><td>{selectedOwningTeam}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Key Vault URL</td><td>{selectedKeyVaultUrl}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Certificate Name</td><td>{selectedKeyVaultCertificateName}</td></tr>");
        }
        
        // Date range (common for all)
        html.Append($"<tr><td class='fw-bold'>Start Date Time</td><td>{startDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "Not set"}</td></tr>");
        html.Append($"<tr><td class='fw-bold'>End Date Time</td><td>{endDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "Not set"}</td></tr>");
        
        html.Append("</tbody></table>");
        html.Append("</div>");
        
        return html.ToString();
    }

    private string GetAnalysisTypeName()
    {
        return selectedOption switch
        {
            "workItems" => "Work Items Analysis",
            "gitCommits" => "Git Commits Analysis",
            "icmResolutions" => "ICM Resolutions Analysis",
            _ => "Unknown Analysis"
        };
    }

    private async Task CloseModal()
    {
        await JSRuntime.InvokeVoidAsync("hideModal", "analysisModal");
    }

    private void CloseAnalysisResults()
    {
        // Cache current results before clearing
        if (!string.IsNullOrEmpty(analysisResultHtml) && contributors.Any())
        {
            var cacheKey = selectedOption;
            cachedResults[cacheKey] = (
                new List<(string Name, string Summary)>(contributors),
                new Dictionary<string, string>(contributorDetails),
                new HashSet<string>(expandedRows)
            );
        }
        
        analysisResultHtml = string.Empty;
        expandedRows.Clear();
        contributorDetails.Clear();
        contributors.Clear();
    }

    private async Task ConfirmAnalysis()
    {
        await JSRuntime.InvokeVoidAsync("hideModal", "analysisModal");

        // Remove cached results for current tab to force fresh analysis
        var cacheKey = selectedOption;
        cachedResults.Remove(cacheKey);

        // Close any existing analysis results before starting new analysis
        if (!string.IsNullOrEmpty(analysisResultHtml))
        {
            analysisResultHtml = string.Empty;
            expandedRows.Clear();
            contributorDetails.Clear();
            contributors.Clear();
        }

        if (selectedOption == "gitCommits")
        {
            isLoadingResults = true;
            contributors = new List<(string Name, string Summary)>();
            analysisResultHtml = "gitCommits"; // Flag to render RenderGitCommitsResults with loading state
            StateHasChanged();
            
            // Scroll to bottom to show loading indicator
            try
            {
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("scrollToBottom", true);
            }
            catch { /* Ignore scroll errors */ }

            // Run the API call in background
            _ = Task.Run(async () =>
            {
                try
                {
                    var results = await GetCommitCollection();
                    await InvokeAsync(() =>
                    {
                        contributors = results;
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading commits: {ex.Message}");
                    await InvokeAsync(() =>
                    {
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
            });
        }
        else if (selectedOption == "workItems")
        {
            isLoadingResults = true;
            contributors = new List<(string Name, string Summary)>();
            analysisResultHtml = "workItems"; // Flag to render RenderWorkItemsResults with loading state
            StateHasChanged();
            
            // Scroll to bottom to show loading indicator
            try
            {
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("scrollToBottom", true);
            }
            catch { /* Ignore scroll errors */ }

            // Run the API call in background
            _ = Task.Run(async () =>
            {
                try
                {
                    var results = await GetWorkItemCollection();
                    await InvokeAsync(() =>
                    {
                        contributors = results;
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading work items: {ex.Message}");
                    await InvokeAsync(() =>
                    {
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
            });
        }
        else if (selectedOption == "icmResolutions")
        {
            isLoadingResults = true;
            contributors = new List<(string Name, string Summary)>();
            analysisResultHtml = "icmResolutions";
            StateHasChanged();
            
            try
            {
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("scrollToBottom", true);
            }
            catch { }

            _ = Task.Run(async () =>
            {
                try
                {
                    var results = await GetIncidentCollection();
                    await InvokeAsync(() =>
                    {
                        contributors = results;
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading incidents: {ex.Message}");
                    await InvokeAsync(() =>
                    {
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
            });
        }
        else
        {
            analysisResultHtml = string.Empty;
            StateHasChanged();
        }
    }

    private RenderFragment RenderWorkItemsResults() => __builder =>
    {
        
        <div class="table-responsive">
            <table class="table table-bordered table-sm mb-0">
                <thead>
                    <tr>
                        <th colspan="3" class="text-center fw-bold table-title-header">
                            Work Items Completion Summary for '@selectedOrganization\@selectedProject\@selectedAreaPath'
                        </th>
                    </tr>
                    <tr>
