    private async Task ToggleRow(string contributorName)
    {
        if (expandedRows.Contains(contributorName))
        {
            expandedRows.Remove(contributorName);
        }
        else
        {
            expandedRows.Add(contributorName);
            
            // Load details if not already loaded
            if (!contributorDetails.ContainsKey(contributorName))
            {
                StateHasChanged(); // Show loading state
                
                string details;
                if (selectedOption == "workItems")
                {
                    details = await GetWorkContributionDetails(contributorName);
                }
                else if (selectedOption == "gitCommits")
                {
                    details = await GetCodeContributionDetails(contributorName);
                }
                else // icmResolutions
                {
                    details = await GetIncidentAttendanceDetails(contributorName);
                }
                
                contributorDetails[contributorName] = details;
                StateHasChanged(); // Show loaded details
            }
        }
    }

    
    private async Task<List<(string Name, string Summary)>> GetIncidentCollection()
    {
        IncidentQueryOptions incidentQueryOptions = GetIncidentQueryOptions();

        X509Certificate2 keyvaultCertificate = await KeyVaultUtilities.GetCertificateAsync(
            incidentQueryOptions.KeyVaultUrl,
            incidentQueryOptions.KeyVaultCertificateName);

        var resolvedIncidents = await IncidentAttendanceMetrics.SearchResolvedIncidentsAsync(
            keyvaultCertificate,
            incidentQueryOptions.OwningTeam,
            incidentQueryOptions.StartDateTime, 
            incidentQueryOptions.EndDateTime);

        var mitigatedIncidents = await IncidentAttendanceMetrics.SearchMitigatedIncidentsAsync(
            keyvaultCertificate,
            incidentQueryOptions.OwningTeam,
            incidentQueryOptions.StartDateTime,
            incidentQueryOptions.EndDateTime);

        // Fetch active incidents
        activeIncidents = await IncidentAttendanceMetrics.SearchAllActiveIncidentsAsync(
            keyvaultCertificate,
            incidentQueryOptions.OwningTeam);

        // Fetch created incidents
        createdIncidents = await IncidentAttendanceMetrics.SearchCreatedIncidentsAsync(
            keyvaultCertificate,
            incidentQueryOptions.OwningTeam,
            incidentQueryOptions.StartDateTime,
            incidentQueryOptions.EndDateTime);

        // Combine resolved and mitigated incidents
        var allIncidents = new List<IncidentValue>();
        if (resolvedIncidents?.value != null)
        {
            allIncidents.AddRange(resolvedIncidents.value);
        }
        if (mitigatedIncidents?.value != null)
        {
            allIncidents.AddRange(mitigatedIncidents.value);
        }

        // Store incidents grouped by contributor
        groupedIncidentsByContributor = new Dictionary<string, IncidentCollection>();
        
        foreach (var incident in allIncidents)
        {
            var changedBy = incident.ResolutionData?.ChangedBy ?? incident.MitigationData?.ChangedBy ?? "Unknown";
            
            if (!groupedIncidentsByContributor.ContainsKey(changedBy))
            {
                groupedIncidentsByContributor[changedBy] = new IncidentCollection { value = new List<IncidentValue>() };
            }
            
            groupedIncidentsByContributor[changedBy].value?.Add(incident);
        }

        // Create summary statistics
        var incidentStatistics = groupedIncidentsByContributor
            .Select(g => new
            {
                Name = g.Key,
                TotalIncidents = g.Value.value?.Count ?? 0,
                ResolvedCount = g.Value.value?.Count(i => i.Status == "Resolved") ?? 0,
                MitigatedCount = g.Value.value?.Count(i => i.Status == "Mitigated") ?? 0,
                ActiveCount = activeIncidents?.value?.Count(i => i.OwningContactAlias?.Equals(g.Key, StringComparison.OrdinalIgnoreCase) == true) ?? 0,
                CreatedCount = createdIncidents?.value?.Count(i => i.OwningContactAlias?.Equals(g.Key, StringComparison.OrdinalIgnoreCase) == true) ?? 0
            })
            .OrderByDescending(x => x.TotalIncidents)
            .Select(x => (
                Name: x.Name,
                Summary: $"{x.TotalIncidents} incident{(x.TotalIncidents != 1 ? "s" : "")} closed ({x.ResolvedCount} resolved, {x.MitigatedCount} mitigated, {x.ActiveCount} active, {x.CreatedCount} created)"
            ))
            .ToList();

        return incidentStatistics;
    }

    private async Task<string> GetIncidentAttendanceDetails(string contributorName)
    {
        if (groupedIncidentsByContributor == null || !groupedIncidentsByContributor.ContainsKey(contributorName))
        {
            return "<div class='incident-entry'><div class='incident-info'><em>No incidents found.</em></div></div>";
        }

        var contributorIncidents = groupedIncidentsByContributor[contributorName].value;
        if (contributorIncidents == null || !contributorIncidents.Any())
        {
            return $"<div class='incident-entry'><div class='incident-info'><em>No incidents found for {contributorName}.</em></div></div>";
        }

        var orderedIncidents = contributorIncidents
            .OrderBy(i => i.Severity ?? int.MaxValue)
            .ThenBy(i => i.Status == "Resolved" ? 0 : 1)
            .ThenByDescending(i => i.ResolutionData?.Date ?? i.MitigationData?.Date ?? i.ModifiedDate)
            .ToList();

        var details = new System.Text.StringBuilder();

        // Calculate totals for contributor
        var totalIncidents = orderedIncidents.Count;
        var resolvedCount = orderedIncidents.Count(i => i.Status == "Resolved");
        var mitigatedCount = orderedIncidents.Count(i => i.Status == "Mitigated");
        var incidentsBySeverity = orderedIncidents
            .GroupBy(i => i.Severity ?? 0)
            .ToDictionary(g => g.Key, g => g.Count());

        // Calculate TTR (Time To Resolve) statistics
        var timeToResolveList = new List<double>();
        foreach (var incident in orderedIncidents.Where(i => i.Status == "Resolved" && i.ResolutionData != null))
        {
            var ttr = (incident.ResolutionData!.Date - incident.CreateDate).TotalHours;
            if (ttr >= 0)
            {
                timeToResolveList.Add(ttr);
            }
        }

        // Calculate TTM (Time To Mitigate) statistics
        var timeToMitigateList = new List<double>();
        foreach (var incident in orderedIncidents.Where(i => i.MitigationData != null))
        {
            var ttm = (incident.MitigationData!.Date - incident.CreateDate).TotalHours;
            if (ttm >= 0)
            {
                timeToMitigateList.Add(ttm);
            }
        }

        // Add contributor summary header
        details.Append("<div class='contributor-summary mb-3 p-3' style='background-color: var(--bs-secondary-bg); border-left: 4px solid var(--bs-primary); border-radius: 4px;'>")
               .Append($"<h6 class='fw-bold mb-2'>📊 Summary for {contributorName}</h6>")
               .Append($"<div><strong>Total Incidents:</strong> {totalIncidents}</div>")
               .Append($"<div><strong>Resolved:</strong> {resolvedCount}</div>")
               .Append($"<div><strong>Mitigated:</strong> {mitigatedCount}</div>");

        if (incidentsBySeverity.Any())
        {
            details.Append("<div class='mt-2'><strong>By Severity:</strong></div>")
                   .Append("<div style='margin-left: 20px;'>");
            foreach (var sev in incidentsBySeverity.OrderBy(kvp => kvp.Key))
            {
                details.Append($"<div>Severity {sev.Key}: {sev.Value}</div>");
            }
            details.Append("</div>");
        }

        // Add TTM statistics
        if (timeToMitigateList.Any())
        {
            var minTTM = timeToMitigateList.Min();
            var maxTTM = timeToMitigateList.Max();
            var avgTTM = timeToMitigateList.Average();

            details.Append("<div class='mt-2'><strong>⚡ Time To Mitigate (TTM):</strong></div>")
                   .Append("<div style='margin-left: 20px;'>")
                   .Append($"<div>Minimum: {FormatTTR(minTTM)}</div>")
                   .Append($"<div>Average: {FormatTTR(avgTTM)}</div>")
                   .Append($"<div>Maximum: {FormatTTR(maxTTM)}</div>")
                   .Append("</div>");
        }

        // Add TTR statistics
        if (timeToResolveList.Any())
        {
            var minTTR = timeToResolveList.Min();
            var maxTTR = timeToResolveList.Max();
            var avgTTR = timeToResolveList.Average();

            details.Append("<div class='mt-2'><strong>⏱️ Time To Resolve (TTR):</strong></div>")
                   .Append("<div style='margin-left: 20px;'>")
                   .Append($"<div>Minimum: {FormatTTR(minTTR)}</div>")
                   .Append($"<div>Average: {FormatTTR(avgTTR)}</div>")
                   .Append($"<div>Maximum: {FormatTTR(maxTTR)}</div>")
                   .Append("</div>");
        }

        details.Append("</div>");

        // Add separator after summary
        details.Append("<hr class='my-3' style='border-top: 2px solid var(--bs-primary); opacity: 0.3;'/>");

        foreach (var incident in orderedIncidents)
        {
            var incidentId = incident.Id ?? "Unknown";
            var title = incident.Title ?? "No title";
            var status = incident.Status ?? "Unknown";
            var severity = incident.Severity ?? 0;
            var createdDate = incident.CreateDate;
            var isOutage = incident.IsOutage;
            var owningContactAlias = incident.OwningContactAlias ?? "Unknown";

            var statusBadgeClass = status == "Resolved" ? "success" : status == "Mitigated" ? "warning" : "info";
            var mitigatedByName = incident.MitigationData?.ChangedBy ?? "Unknown";
            var resolvedByName = incident.ResolutionData?.ChangedBy ?? "Unknown";

            details.Append("<div class='incident-entry'>")
                   .Append($"<div class='incident-header'>🚨 <strong>Incident:</strong> <span class='incident-id'>#{incidentId}</span> - Severity {severity}</div>")
                   .Append($"<div class='incident-info'>📋 <strong>Title:</strong> {System.Web.HttpUtility.HtmlEncode(title)}</div>")
                   .Append($"<div class='incident-info'>📊 <strong>Status:</strong> <span class='badge bg-{statusBadgeClass}'>{status}</span></div>")
                   .Append($"<div class='incident-info'>⚡ <strong>Severity:</strong> {severity}</div>");

            if (isOutage)
            {
                details.Append("<div class='incident-info'>⛔ <strong>Outage:</strong> <span class='badge bg-danger'>Yes</span></div>");
            }

            details.Append($"<div class='incident-info'>👤 <strong>Owning Contact:</strong> {owningContactAlias}</div>")
                   .Append($"<div class='incident-info'>📅 <strong>Created Date:</strong> {createdDate:yyyy-MM-dd HH:mm:ss}</div>");

            if (incident.MitigationData != null)
            {
                details.Append($"<div class='incident-info'>✅ <strong>Mitigation Date:</strong> {incident.MitigationData.Date:yyyy-MM-dd HH:mm:ss}</div>")
                       .Append($"<div class='incident-info'>👤 <strong>Mitigated By:</strong> {mitigatedByName}</div>");
                
                if (!string.IsNullOrEmpty(incident.MitigationData.Mitigation))
                {
                    details.Append($"<div class='incident-info'>💬 <strong>Mitigation:</strong> {System.Web.HttpUtility.HtmlEncode(incident.MitigationData.Mitigation)}</div>");
                }

                var timeToMitigate = incident.MitigationData.Date - createdDate;
                details.Append($"<div class='incident-info'>⏱️ <strong>Time to Mitigate (TTM):</strong> {timeToMitigate.TotalHours:F1} hours</div>");
            }

            if (incident.ResolutionData != null)
            {
                details.Append($"<div class='incident-info'>✅ <strong>Resolution Date:</strong> {incident.ResolutionData.Date:yyyy-MM-dd HH:mm:ss}</div>")
                       .Append($"<div class='incident-info'>👤 <strong>Resolved By:</strong> {resolvedByName}</div>");

                var timeToResolve = incident.ResolutionData.Date - createdDate;
                details.Append($"<div class='incident-info'>⏱️ <strong>Time to Resolve (TTR):</strong> {timeToResolve.TotalHours:F1} hours</div>");
            }

            // Add link to incident
            details.Append($"<div class='incident-info'>🌐 <strong>URL:</strong> <a href='https://portal.microsofticm.com/imp/v5/incidents/details/{incidentId}/summary' target='_blank'>View Incident</a></div>");

            details.Append("</div>");

            // Add separator between incidents except for the last one
            if (incident != orderedIncidents.Last())
            {
                details.Append("<hr class='incident-separator'/>");
            }
        }

        return details.ToString();
    }

    private async Task<string> GetWorkContributionDetails(string contributorName)
    {
        if (workItemDetailsCollection?.value == null || !workItemDetailsCollection.value.Any())
        {
            return "<div class='work-item-entry'><div class='work-item-info'><em>No work items found.</em></div></div>";
        }

        var contributorWorkItems = this.workItemDetailsCollection.value
           .Where(w => (w.fields?.SystemAssignedTo?.displayName ?? "Unassigned") == contributorName)
           .OrderByDescending(w => w.fields?.MicrosoftVSTSCommonClosedDate ?? w.fields?.SystemChangedDate ?? DateTime.MinValue)
           .ToList();

        if (!contributorWorkItems.Any())
        {
            return $"<div class='work-item-entry'><div class='work-item-info'><em>No work items found for {contributorName}.</em></div></div>";
        }

        WorkItemQueryOptions workItemQueryOptions = GetWorkItemQueryOptions();

        Dictionary<int, WorkItemHistoryCollection> workItemHistoryCollectionMap =  await WorkItemCompletionMetrics.GetWorkItemHistoryCollectionAsync(
            workItemQueryOptions.OrganizationName,
            new WorkItemDetailsCollection() { count = contributorWorkItems.Count, value = contributorWorkItems});

        var details = new System.Text.StringBuilder();

        // Calculate totals for contributor
        var totalWorkItems = contributorWorkItems.Count;
        var workItemsByType = contributorWorkItems
            .GroupBy(w => w.fields?.SystemWorkItemType ?? "Unknown")
            .ToDictionary(g => g.Key, g => g.Count());

        // Collect days in active work states for all work items
        var daysInActiveWorkStates = new List<double>();
        
        foreach (var workItem in contributorWorkItems)
        {
            var workItemId = workItem.fields?.SystemId ?? 0;
            if (workItemHistoryCollectionMap.TryGetValue(workItemId, out var historyCollection) &&
                historyCollection?.value != null && historyCollection.value.Count > 1)
            {
                // Build state periods for this work item
                var statePeriods = new List<(string State, DateTime EntryDate, DateTime? ExitDate)>();
                
                string? currentTrackedState = null;
                DateTime currentStateEntryDate = DateTime.MinValue;

                for (int i = 0; i < historyCollection.value.Count; i++)
                {
                    var revision = historyCollection.value[i];
                    var revisionState = revision.fields?.SystemState;
                    var revisionDate = revision.fields?.SystemChangedDate ?? DateTime.Now;

                    if (i == 0)
                    {
                        currentTrackedState = revisionState;
                        currentStateEntryDate = revisionDate;
                    }
                    else if (revisionState != currentTrackedState)
                    {
                        if (currentTrackedState != null)
                        {
                            statePeriods.Add((currentTrackedState, currentStateEntryDate, revisionDate));
                        }
                        currentTrackedState = revisionState;
                        currentStateEntryDate = revisionDate;
                    }
                }

                if (currentTrackedState != null)
                {
                    statePeriods.Add((currentTrackedState, currentStateEntryDate, null));
                }

                // Calculate total time in active work states for this work item
                double totalDaysInActiveStates = 0;
                foreach (var period in statePeriods)
                {
                    if (period.State.Equals("Committed", StringComparison.OrdinalIgnoreCase) ||
                        period.State.Equals("Active", StringComparison.OrdinalIgnoreCase) ||
                        period.State.Equals("In Progress", StringComparison.OrdinalIgnoreCase))
                    {
                        var exitDate = period.ExitDate ?? DateTime.Now;
                        var duration = exitDate - period.EntryDate;
                        totalDaysInActiveStates += duration.TotalDays;
                    }
                }

                if (totalDaysInActiveStates > 0)
                {
                    daysInActiveWorkStates.Add(totalDaysInActiveStates);
                }
            }
        }

        // Add contributor summary header
        details.Append("<div class='contributor-summary mb-3 p-3' style='background-color: var(--bs-secondary-bg); border-left: 4px solid var(--bs-primary); border-radius: 4px;'>")
               .Append($"<h6 class='fw-bold mb-2'>📊 Summary for {contributorName}</h6>")
               .Append($"<div><strong>Total Work Items Completed:</strong> {totalWorkItems}</div>");
        
        foreach (var typeGroup in workItemsByType.OrderByDescending(kvp => kvp.Value))
        {
            details.Append($"<div><strong>{typeGroup.Key}:</strong> {typeGroup.Value}</div>");
        }

        // Add time analysis statistics
        if (daysInActiveWorkStates.Any())
        {
            var totalDays = daysInActiveWorkStates.Sum();
            var maxDays = daysInActiveWorkStates.Max();
            var minDays = daysInActiveWorkStates.Min();
            var averageDays = daysInActiveWorkStates.Average();
            var sortedDays = daysInActiveWorkStates.OrderBy(d => d).ToList();
            var medianDays = sortedDays.Count % 2 == 0
                ? (sortedDays[sortedDays.Count / 2 - 1] + sortedDays[sortedDays.Count / 2]) / 2
                : sortedDays[sortedDays.Count / 2];

            details.Append("<div class='mt-2'><strong>⏱️ Time Analysis (Committed/Active/In Progress states only):</strong></div>")
                   .Append($"<div style='margin-left: 20px;'>")
                   .Append($"<div>Total Days: {totalDays:F1}</div>")
                   .Append($"<div>Maximum Days: {maxDays:F1}</div>")
                   .Append($"<div>Minimum Days: {minDays:F1}</div>")
                   .Append($"<div>Average Days: {averageDays:F1}</div>")
                   .Append($"<div>Median Days: {medianDays:F1}</div>")
                   .Append($"<div>Work Items with Active Work Time: {daysInActiveWorkStates.Count} of {totalWorkItems}</div>")
                   .Append("</div>");
        }
        else
        {
            details.Append("<div class='mt-2'><strong>⏱️ Time Analysis:</strong> No time spent in Committed/Active/In Progress states found for work items.</div>");
        }
        
        details.Append("</div>");

        // Add separator after summary
        details.Append("<hr class='my-3' style='border-top: 2px solid var(--bs-primary); opacity: 0.3;'/>");

        foreach (var workItem in contributorWorkItems)
        {
            var workItemId = workItem.fields?.SystemId ?? 0;
            var title = workItem.fields?.SystemTitle ?? "No title";
            var workItemType = workItem.fields?.SystemWorkItemType ?? "Unknown";
            var state = workItem.fields?.SystemState ?? "Unknown";
            var createdDate = workItem.fields?.SystemCreatedDate ?? DateTime.MinValue;
            var closedDate = workItem.fields?.MicrosoftVSTSCommonClosedDate;
            var changedDate = workItem.fields?.SystemChangedDate ?? DateTime.MinValue;
            var priority = workItem.fields?.MicrosoftVSTSCommonPriority;
            var areaPath = workItem.fields?.SystemAreaPath ?? "";
            var iterationPath = workItem.fields?.SystemIterationPath ?? "";

            details.Append("<div class='work-item-entry'>")
                   .Append($"<div class='work-item-header'>📋 Work Item #{workItemId} - <span class='work-item-type'>{workItemType}</span></div>")
                   .Append($"<div class='work-item-info'><strong>📝 Title:</strong> {System.Web.HttpUtility.HtmlEncode(title)}</div>")
                   .Append($"<div class='work-item-info'><strong>🔄 State:</strong> <span class='badge bg-success'>{state}</span></div>");
            
            if (priority.HasValue)
            {
                details.Append($"<div class='work-item-info'><strong>⚡ Priority:</strong> {priority.Value}</div>");
            }
            
            details.Append($"<div class='work-item-info'><strong>📅 Created Date:</strong> {createdDate:yyyy-MM-dd HH:mm:ss}</div>");
            
            if (closedDate.HasValue)
            {
                details.Append($"<div class='work-item-info'><strong>✅ Closed Date:</strong> {closedDate.Value:yyyy-MM-dd HH:mm:ss}</div>");
                
                // Calculate days to complete
                var daysToComplete = (closedDate.Value - createdDate).TotalDays;
                details.Append($"<div class='work-item-info'><strong>⏱️ Time to Complete:</strong> {daysToComplete:F1} days</div>");
            }
            else
            {
                details.Append($"<div class='work-item-info'><strong>🕒 Last Changed:</strong> {changedDate:yyyy-MM-dd HH:mm:ss}</div>");
            }

            if (!string.IsNullOrEmpty(areaPath))
            {
                details.Append($"<div class='work-item-info'><strong>📂 Area Path:</strong> {System.Web.HttpUtility.HtmlEncode(areaPath)}</div>");
            }

            if (!string.IsNullOrEmpty(iterationPath))
            {
                details.Append($"<div class='work-item-info'><strong>🔁 Iteration:</strong> {System.Web.HttpUtility.HtmlEncode(iterationPath)}</div>");
            }

            // Add work item history and state transitions
            if (workItemHistoryCollectionMap.TryGetValue(workItemId, out var historyCollection) &&
                historyCollection?.value != null && historyCollection.value.Count > 1)
            {
                // Build state periods: track when each state started and ended
                var statePeriods = new List<(string State, DateTime EntryDate, DateTime? ExitDate, string EnteredBy)>();
                
                string? currentTrackedState = null;
                DateTime currentStateEntryDate = DateTime.MinValue;
                string currentStateEnteredBy = "Unknown";

                for (int i = 0; i < historyCollection.value.Count; i++)
                {
                    var revision = historyCollection.value[i];
                    var revisionState = revision.fields?.SystemState;
                    var revisionDate = revision.fields?.SystemChangedDate ?? DateTime.Now;
                    var changedBy = revision.fields?.SystemChangedBy?.displayName ?? "Unknown";

                    if (i == 0)
                    {
                        // First revision - initialize state tracking
                        currentTrackedState = revisionState;
                        currentStateEntryDate = revisionDate;
                        currentStateEnteredBy = changedBy;
                    }
                    else if (revisionState != currentTrackedState)
                    {
                        // State changed - close previous state period and start new one
                        if (currentTrackedState != null)
                        {
                            statePeriods.Add((currentTrackedState, currentStateEntryDate, revisionDate, currentStateEnteredBy));
                        }
                        currentTrackedState = revisionState;
                        currentStateEntryDate = revisionDate;
                        currentStateEnteredBy = changedBy;
                    }
                }

                // Close the final state period (still ongoing)
                if (currentTrackedState != null)
                {
                    statePeriods.Add((currentTrackedState, currentStateEntryDate, null, currentStateEnteredBy));
                }

                // Calculate total time spent in each state
                var stateDurations = new Dictionary<string, TimeSpan>();
                
                foreach (var period in statePeriods)
                {
                    var exitDate = period.ExitDate ?? DateTime.Now;
                    var duration = exitDate - period.EntryDate;

                    if (!stateDurations.ContainsKey(period.State))
                        stateDurations[period.State] = TimeSpan.Zero;
                    stateDurations[period.State] = stateDurations[period.State].Add(duration);
                }

                // Calculate time spent in active work states (Committed, Active, In Progress)
                TimeSpan totalActiveWorkTime = TimeSpan.Zero;
                foreach (var stateDuration in stateDurations)
                {
                    if (stateDuration.Key.Equals("Committed", StringComparison.OrdinalIgnoreCase) ||
                        stateDuration.Key.Equals("Active", StringComparison.OrdinalIgnoreCase) ||
                        stateDuration.Key.Equals("In Progress", StringComparison.OrdinalIgnoreCase))
                    {
                        totalActiveWorkTime = totalActiveWorkTime.Add(stateDuration.Value);
                    }
                }

                if (totalActiveWorkTime.TotalDays > 0)
                {
                    details.Append($"<div class='work-item-info'><strong>⏱️ Time in Active Work:</strong> {totalActiveWorkTime.TotalDays:F1} days</div>");
                }

                // Show state change history
                details.Append("<div class='work-item-info'><strong>📜 State Change History:</strong></div>");
                details.Append("<div class='state-history' style='margin-left: 20px; font-size: 0.9em;'>");

                for (int i = 0; i < statePeriods.Count; i++)
                {
                    var period = statePeriods[i];
                    var exitDate = period.ExitDate ?? DateTime.Now;
                    var duration = exitDate - period.EntryDate;
                    var durationStr = FormatUtilities.ToStringValue(duration);
                    
                    if (period.ExitDate.HasValue && i + 1 < statePeriods.Count)
                    {
                        var nextPeriod = statePeriods[i + 1];
                        details.Append($"<div>• {period.ExitDate.Value:yyyy-MM-dd HH:mm} - <strong>{nextPeriod.EnteredBy}</strong>: {period.State} → {nextPeriod.State} <em>(spent {durationStr} in '{period.State}')</em></div>");
                    }
                    else if (!period.ExitDate.HasValue)
                    {
                        details.Append($"<div>• Currently in <strong>{period.State}</strong> since {period.EntryDate:yyyy-MM-dd HH:mm} <em>({durationStr})</em></div>");
                    }
                }

                details.Append("</div>");
            }

            // Add link to work item
            if (workItem._links?.html?.href != null)
            {
                details.Append($"<div class='work-item-info'>🌐 <strong>URL:</strong> <a href='{workItem._links.html.href}' target='_blank'>View Work Item</a></div>");
            }

            details.Append("</div>");
            
            // Add separator between work items except for the last one
            if (workItem != contributorWorkItems.Last())
            {
                details.Append("<hr class='work-item-separator'/>");
            }
        }

        return details.ToString();
    }

    private async Task<List<(string Name, string Summary)>> GetWorkItemCollection()
    {
        WorkItemQueryOptions workItemQueryOptions = GetWorkItemQueryOptions();

        this.workItemDetailsCollection = await WorkItemCompletionMetrics.QueryWorkItemDetailsAsync(
            organizationName: workItemQueryOptions.OrganizationName,
            projectName: workItemQueryOptions.ProjectName,
            teamName: workItemQueryOptions.TeamName,
            areaPath: workItemQueryOptions.AreaPath,
            targetState: "Done", 
            startDate: workItemQueryOptions.StartDateTime ?? DateTime.UtcNow.AddDays(-30),
            endDate: workItemQueryOptions.EndDateTime ?? DateTime.UtcNow);
    
        if (workItemDetailsCollection?.value == null || !workItemDetailsCollection.value.Any())
        {
            return new List<(string Name, string Summary)>();
        }

        // Group work items by assignee and count
        var workItemStatistics = workItemDetailsCollection.value
            .GroupBy(w => w.fields?.SystemAssignedTo?.displayName ?? "Unassigned")
            .Select(g => new
            {
                Name = g.Key,
                WorkItemCount = g.Count()
            })
            .OrderByDescending(x => x.WorkItemCount)
            .Select(x => (
                Name: x.Name,
                Summary: $"{x.WorkItemCount} work item{(x.WorkItemCount != 1 ? "s" : "")} completed"
            ))
            .ToList();

        return workItemStatistics;
    }

    private async Task<List<(string Name, string Summary)>> GetCommitCollection()
    {
        CommitQueryOptions commitQueryOptions = GetCommitQueryOptions();

        commitCollection = await GitCommitMetrics.GetCommitsAsync(
            commitQueryOptions.OrganizationName,
            commitQueryOptions.ProjectName,
            commitQueryOptions.GitRepositoryName,
            commitQueryOptions.TargetBranchName,
            commitQueryOptions.StartDateTime ?? DateTime.UtcNow.AddDays(-30),
            commitQueryOptions.EndDateTime ?? DateTime.UtcNow);

        if (commitCollection?.value == null || !commitCollection.value.Any())
        {
            return new List<(string Name, string Summary)>();
        }

        // Group commits by author/committer name and aggregate
        var commitStatistics = commitCollection.value
            .GroupBy(c => c.committer?.name ?? c.author?.name ?? "Unknown")
            .Select(g => new
            {
                Name = g.Key,
                CommitCount = g.Count(),
                TotalAdded = g.Sum(c => c.changeCounts?.Add ?? 0),
                TotalDeleted = g.Sum(c => c.changeCounts?.Delete ?? 0),
                TotalEdited = g.Sum(c => c.changeCounts?.Edit ?? 0)
            })
            .OrderByDescending(x => x.CommitCount)
            .ThenByDescending(x => x.TotalAdded + x.TotalDeleted + x.TotalEdited)
            .Select(x => (
                Name: x.Name,
                Summary: $"{x.CommitCount} commit{(x.CommitCount != 1 ? "s" : "")} (+{x.TotalAdded}/-{x.TotalDeleted}/{x.TotalEdited} files)"
            ))
            .ToList();

        return commitStatistics;
    }

    private async Task<string> GetCodeContributionDetails(string contributorName)
    {
        if (commitCollection?.value == null || !commitCollection.value.Any())
        {
            return "<div class='commit-entry'><div class='commit-info'><em>No commits found.</em></div></div>";
        }

        var contributorCommits = this.commitCollection.value
           .Where(c => (c.committer?.name ?? c.author?.name ?? "Unknown") == contributorName)
           .OrderByDescending(c => c.committer?.date ?? c.author?.date ?? DateTime.MinValue)
           .ToList();

        if (!contributorCommits.Any())
        {
            return $"<div class='commit-entry'><div class='commit-info'><em>No commits found for {contributorName}.</em></div></div>";
        }

        CommitCollection? contributorCommitCollection = new CommitCollection()
        {
            count = contributorCommits.Count,
            value = contributorCommits
        };

        CommitQueryOptions commitQueryOptions = GetCommitQueryOptions();

        GitCommitCollection? gitCommitCollection = await GitCommitMetrics.GetCommitLineDetailsAsync(
            commitQueryOptions.OrganizationName,
            commitQueryOptions.ProjectName,
            commitQueryOptions.GitRepositoryName,
            commitQueryOptions.TargetBranchName,
            contributorCommitCollection);

        if (gitCommitCollection?.Value == null || !gitCommitCollection.Value.Any())
        {
            return $"<div class='commit-entry'><div class='commit-info'><em>No detailed commit information available for {contributorName}.</em></div></div>";
        }

        var details = new System.Text.StringBuilder();

        // Calculate totals for contributor
        var totalAddedLines = gitCommitCollection.Value.Sum(c => c.AddedLines);
        var totalDeletedLines = gitCommitCollection.Value.Sum(c => c.DeletedLines);
        var totalFilesChanged = gitCommitCollection.Value.Sum(c => c.ChangedFilesCommitTypes.Count);
        var totalCommits = gitCommitCollection.Value.Count;

        // Add contributor summary header
        details.Append("<div class='contributor-summary mb-3 p-3' style='background-color: var(--bs-secondary-bg); border-left: 4px solid var(--bs-primary); border-radius: 4px;'>")
               .Append($"<h6 class='fw-bold mb-2'>📊 Summary for {contributorName}</h6>")
               .Append($"<div><strong>Total Commits:</strong> {totalCommits}</div>")
               .Append($"<div><strong>Total Lines Added:</strong> <span class='text-success'>+{totalAddedLines}</span></div>")
               .Append($"<div><strong>Total Lines Deleted:</strong> <span class='text-danger'>-{totalDeletedLines}</span></div>")
               .Append($"<div><strong>Total Files Changed:</strong> {totalFilesChanged}</div>")
               .Append("</div>");

        // Add separator after summary
        details.Append("<hr class='my-3' style='border-top: 2px solid var(--bs-primary); opacity: 0.3;'/>");

        foreach (var gitCommit in gitCommitCollection.Value)
        {
            var commitDate = gitCommit.CommitterDate;
            var authorName = gitCommit.AuthorName ?? "Unknown";
            var authorEmail = gitCommit.AuthorEmail ?? "";
            var committerName = gitCommit.CommitterName ?? "Unknown";
            var committerEmail = gitCommit.CommitterEmail ?? "";
            var commitMessage = gitCommit.Comment ?? "No message";
            var commitIdShort = gitCommit.CommitId?.Substring(0, Math.Min(8, gitCommit.CommitId.Length)) ?? "Unknown";
            
            var addedLines = gitCommit.AddedLines;
            var deletedLines = gitCommit.DeletedLines;
            var filesChanged = gitCommit.ChangedFilesCommitTypes.Count;

            details.Append("<div class='commit-entry'>")
                   .Append($"<div class='commit-header'>🔄 <strong>Commit:</strong> <span class='commit-hash'>{commitIdShort}...</span></div>")
                   .Append($"<div class='commit-info'>👤 <strong>Author:</strong> {authorName}");
            
            if (!string.IsNullOrEmpty(authorEmail))
            {
                details.Append($" &lt;{authorEmail}&gt;");
            }
            
            details.Append($"<div class='commit-info'>✍️ <strong>Committer:</strong> {committerName}");

            if (!string.IsNullOrEmpty(committerEmail))
            {
                details.Append($" &lt;{committerEmail}&gt;");
            }

            details.Append("</div>")
                   .Append($"<div class='commit-info'>📅 <strong>Date:</strong> {commitDate:yyyy-MM-dd HH:mm:ss}</div>")
                   .Append($"<div class='commit-info'>💬 <strong>Message:</strong> {System.Web.HttpUtility.HtmlEncode(commitMessage)}</div>")
                   .Append($"<div class='commit-stats'>📊 <strong>Line Changes:</strong> <span class='text-success'>+{addedLines} additions</span>, <span class='text-danger'>-{deletedLines} deletions</span></div>")
                   .Append($"<div class='commit-info'><strong>📁 Files Changed:</strong> {filesChanged}</div>");

            // Show changed files details
            if (gitCommit.ChangedFilesCommitTypes.Any())
            {
                details.Append("<div class='commit-files'>📝 <strong>Changed Files:</strong>");
                foreach (var file in gitCommit.ChangedFilesCommitTypes.Take(10)) // Limit to first 10 files
                {
                    var filePath = file.Key;
                    var changeType = file.Value;
                    
                    // Get per-file line counts with proper default values
                    var fileAdded = gitCommit.ChangedFilesAddedLineCounts?.ContainsKey(filePath) == true 
                        ? gitCommit.ChangedFilesAddedLineCounts[filePath] 
                        : 0;
                    var fileDeleted = gitCommit.ChangedFilesDeletedLineCounts?.ContainsKey(filePath) == true 
                        ? gitCommit.ChangedFilesDeletedLineCounts[filePath] 
                        : 0;
                    
                    details.Append($"<div class='file-item' style='margin-left: 20px;'>📄 {System.Web.HttpUtility.HtmlEncode(filePath)} [{changeType}] (+{fileAdded}/-{fileDeleted})</div>");
                }
                
                if (gitCommit.ChangedFilesCommitTypes.Count > 10)
                {
                    details.Append($"<div class='file-item' style='margin-left: 20px;'><em>... and {gitCommit.ChangedFilesCommitTypes.Count - 10} more files</em></div>");
                }
                
                details.Append("</div>");
            }

            if (!string.IsNullOrEmpty(gitCommit.RemoteUrl))
            {
                details.Append($"<div class='commit-info'>🌐 <strong>URL:</strong> <a href='{gitCommit.RemoteUrl}' target='_blank'>View Commit</a></div>");
            }

            details.Append("</div>");
            
            // Add separator between commits except for the last one
            if (gitCommit != gitCommitCollection.Value.Last())
            {
                details.Append("<hr class='commit-separator'/>");
            }
        }

        return details.ToString();
    }

    private string FormatTTR(double hours)
    {
        if (hours < 1)
        {
            return $"{hours * 60:F0} minutes";
        }
        else if (hours < 24)
        {
            return $"{hours:F1} hours";
        }
        else
        {
            var days = hours / 24;
            return $"{days:F1} days";
        }
    }

