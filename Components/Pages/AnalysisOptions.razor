    private static string BuildGitCombination(string organization, string project, string gitRepository, string branch)
    {
        return $"{organization}{TeamCombinationSeparator}{project}{TeamCombinationSeparator}{gitRepository}{TeamCombinationSeparator}{branch}";
    }

    private static string GetTargetBranchForRepo(string gitRepository)
    {
        // Repositories that use "main" branch
        var mainBranchRepos = new[] { "workload-sparkcore", "workload-lakehouse", "workload-genericcomputemanager",
                                      "workload-vpaas", "fabric-libraries", "fabric-spark-load-testing-suite",
                                      "SparkRuntimeTSGs", "nebula", "impulse", "spark-driver-adonet", "spark-driver-jdbc", "spark-driver-odbc",
                                      "AIAgents" };

        // Repositories that use "master" branch
        var masterBranchRepos = new[] { "FeatureManagement", "aspaas", "wildfire-livy",
                                        "BBC-VHD", "BBC-Probes", "marlin" };

        if (gitRepository == "wildfire-delta")
        {
            return "release/3.2";
        }
        if (gitRepository == "wildfire-spark")
        {
            return "spark-3.5-mnt";
        }
        if (gitRepository == "BBC")
        {
            return "develop";
        }
        if (gitRepository == "HDInsight-Main")
        {
            return "developer";
        }
        if (mainBranchRepos.Contains(gitRepository))
        {
            return "main";
        }
        if (masterBranchRepos.Contains(gitRepository))
        {
            return "master";
        }
        return "main";
    }

    private void OnSelectedGitCommitCombinationsChanged(object value)
    {
        // Sync the single-selection state to the first selected combination for reuse.
        var first = (selectedGitCommitCombinations ?? Enumerable.Empty<string>()).FirstOrDefault();
        if (string.IsNullOrWhiteSpace(first))
        {
            return;
        }

        var parts = first.Split(TeamCombinationSeparator, 4, StringSplitOptions.None);
        if (parts.Length != 4)
        {
            return;
        }

        selectedOrganization = parts[0];
        selectedProject = parts[1];
        selectedGitRepository = parts[2];
        selectedTargetBranch = parts[3];
    }

    private void OnSelectedOwningTeamsChanged(object value)
    {
        // Sync the single-selection state to the first selected owning team for reuse.
        var first = (selectedOwningTeams ?? Enumerable.Empty<string>()).FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(first))
        {
            selectedOwningTeam = first;
        }
    }

    private string GetTargetBranch()
    {
        // Repositories that use "main" branch
        var mainBranchRepos = new[] { "workload-sparkcore", "workload-lakehouse", "workload-genericcomputemanager", 
                                      "workload-vpaas", "fabric-libraries", "fabric-spark-load-testing-suite", 
                                      "SparkRuntimeTSGs", "nebula", "impulse", "spark-driver-adonet", "spark-driver-jdbc", "spark-driver-odbc",
                                      "AIAgents" };
        
        // Repositories that use "master" branch
        var masterBranchRepos = new[] { "FeatureManagement", "aspaas", "wildfire-livy", 
                                        "BBC-VHD", "BBC-Probes", "marlin" };
        
        // wildfire-delta defaults to release/3.2 branch
        if (selectedGitRepository == "wildfire-delta")
        {
            return "release/3.2";
        }
        
        // wildfire-spark defaults to spark-3.5-mnt branch
        if (selectedGitRepository == "wildfire-spark")
        {
            return "spark-3.5-mnt";
        }
        
        // BBC defaults to develop branch
        if (selectedGitRepository == "BBC")
        {
            return "develop";
        }

        // HDInsight-Main defaults to developer branch
        if (selectedGitRepository == "HDInsight-Main")
        {
            return "developer";
        }
        
        if (mainBranchRepos.Contains(selectedGitRepository))
        {
            return "main";
        }
        else if (masterBranchRepos.Contains(selectedGitRepository))
        {
            return "master";
        }
        
        return "main"; // default
    }

