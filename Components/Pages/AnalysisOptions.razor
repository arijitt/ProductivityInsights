    private string BuildAnalysisParametersHtml()
    {
        var html = new System.Text.StringBuilder();
        html.Append("<div class='parameter-section'>");
        html.Append($"<h6 class='fw-bold text-primary mb-3'>Analysis Type: {GetAnalysisTypeName()}</h6>");
        
        html.Append("<table class='table table-sm table-bordered'>");
        html.Append("<tbody>");

        // Teams + Work Items: reflect the multiselect combinations and the manager filter.
        bool teamsWorkItems = selectedView == "teams" && selectedOption == "workItems";
        bool teamsGitCommits = selectedView == "teams" && selectedOption == "gitCommits";

        // Common parameters
        if (selectedOption != "icmResolutions" && !teamsWorkItems && !teamsGitCommits)
        {
            html.Append($"<tr><td class='fw-bold' style='width: 200px;'>Organization</td><td>{selectedOrganization}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Project</td><td>{selectedProject}</td></tr>");
        }

        // Work Items specific
        if (selectedOption == "workItems")
        {
            if (teamsWorkItems)
            {
                var managerLabel = System.Net.WebUtility.HtmlEncode(selectedManager?.displayName ?? "None selected");
                html.Append($"<tr><td class='fw-bold' style='width: 200px;'>Manager Filter</td><td>{managerLabel}</td></tr>");

                var combinations = ParseSelectedTeamCombinations();
                html.Append($"<tr><td class='fw-bold'>Selections ({combinations.Count})</td><td>");
                if (combinations.Any())
                {
                    html.Append("<ul class='mb-0 ps-3'>");
                    foreach (var (org, project, team, areaPath) in combinations)
                    {
                        var entry = System.Net.WebUtility.HtmlEncode($"{org}{TeamCombinationSeparator}{project}{TeamCombinationSeparator}{team}{TeamCombinationSeparator}{areaPath}");
                        html.Append($"<li>{entry}</li>");
                    }
                    html.Append("</ul>");
                }
                else
                {
                    html.Append("None selected");
                }
                html.Append("</td></tr>");
            }
            else
            {
                if (selectedProject == "A365")
                {
                    html.Append($"<tr><td class='fw-bold'>Team Name</td><td>{selectedTeam}</td></tr>");
                }
                html.Append($"<tr><td class='fw-bold'>Area Path</td><td>{selectedAreaPath}</td></tr>");
            }
        }
        
        // Git Commits specific
        if (selectedOption == "gitCommits")
        {
            if (teamsGitCommits)
            {
                var managerLabel = System.Net.WebUtility.HtmlEncode(selectedManager?.displayName ?? "None selected");
                html.Append($"<tr><td class='fw-bold' style='width: 200px;'>Manager Filter</td><td>{managerLabel}</td></tr>");

                var combinations = ParseSelectedGitCommitCombinations();
                html.Append($"<tr><td class='fw-bold'>Selections ({combinations.Count})</td><td>");
                if (combinations.Any())
                {
                    html.Append("<ul class='mb-0 ps-3'>");
                    foreach (var (org, project, repo, branch) in combinations)
                    {
                        var entry = System.Net.WebUtility.HtmlEncode($"{org}{TeamCombinationSeparator}{project}{TeamCombinationSeparator}{repo}{TeamCombinationSeparator}{branch}");
                        html.Append($"<li>{entry}</li>");
                    }
                    html.Append("</ul>");
                }
                else
                {
                    html.Append("None selected");
                }
                html.Append("</td></tr>");
            }
            else
            {
                html.Append($"<tr><td class='fw-bold'>Git Repository</td><td>{selectedGitRepository}</td></tr>");
                html.Append($"<tr><td class='fw-bold'>Target Branch</td><td>{selectedTargetBranch}</td></tr>");
            }
        }
        
        // ICM Resolutions specific
        if (selectedOption == "icmResolutions")
        {
            if (selectedView == "teams")
            {
                var managerLabel = System.Net.WebUtility.HtmlEncode(selectedManager?.displayName ?? "None selected");
                html.Append($"<tr><td class='fw-bold' style='width: 200px;'>Manager Filter</td><td>{managerLabel}</td></tr>");

                var owningTeams = (selectedOwningTeams ?? Enumerable.Empty<string>())
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
                html.Append($"<tr><td class='fw-bold'>Selections ({owningTeams.Count})</td><td>");
                if (owningTeams.Any())
                {
                    html.Append("<ul class='mb-0 ps-3'>");
                    foreach (var owningTeam in owningTeams)
                    {
                        html.Append($"<li>{System.Net.WebUtility.HtmlEncode(owningTeam)}</li>");
                    }
                    html.Append("</ul>");
                }
                else
                {
                    html.Append("None selected");
                }
                html.Append("</td></tr>");
            }
            else
            {
                html.Append($"<tr><td class='fw-bold'>Owning Team</td><td>{selectedOwningTeam}</td></tr>");
            }
            html.Append($"<tr><td class='fw-bold'>Key Vault URL</td><td>{selectedKeyVaultUrl}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Certificate Name</td><td>{selectedKeyVaultCertificateName}</td></tr>");
        }
        
        // Date range (common for all)
        html.Append($"<tr><td class='fw-bold'>Start Date Time</td><td>{startDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "Not set"}</td></tr>");
        html.Append($"<tr><td class='fw-bold'>End Date Time</td><td>{endDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "Not set"}</td></tr>");
        
        // Trend Interval (only for Trends view)
        if (selectedView == "trends")
        {
            var trendLabel = char.ToUpper(selectedTrendPeriod[0]) + selectedTrendPeriod.Substring(1);
            html.Append($"<tr><td class='fw-bold'>Trend Interval</td><td>{trendLabel}</td></tr>");
        }
        
        html.Append("</tbody></table>");
        html.Append("</div>");
        
        return html.ToString();
    }

    private string GetAnalysisTypeName()
    {
        return selectedOption switch
        {
            "workItems" => "Work Items Analysis",
            "gitCommits" => "Git Commits Analysis",
            "icmResolutions" => "ICM Resolutions Analysis",
            _ => "Unknown Analysis"
        };
    }

    private async Task CloseModal()
    {
        await JSRuntime.InvokeVoidAsync("hideModal", "analysisModal");
    }

    private void CloseAnalysisResults()
    {
        // Cache current results before clearing
        if (!string.IsNullOrEmpty(analysisResultHtml) && contributors.Any())
        {
            var cacheKey = selectedOption;
            cachedResults[cacheKey] = (
                new List<(string Name, string Summary)>(contributors),
                new Dictionary<string, string>(contributorDetails),
                new HashSet<string>(expandedRows)
            );
        }
        
        analysisResultHtml = string.Empty;
        expandedRows.Clear();
        contributorDetails.Clear();
        contributors.Clear();
    }

    private async Task ConfirmAnalysis()
    {
        await JSRuntime.InvokeVoidAsync("hideModal", "analysisModal");

        // Remove cached results for current tab to force fresh analysis
        var cacheKey = selectedOption;
        cachedResults.Remove(cacheKey);

        // Close any existing analysis results before starting new analysis
        if (!string.IsNullOrEmpty(analysisResultHtml))
        {
            analysisResultHtml = string.Empty;
            expandedRows.Clear();
            contributorDetails.Clear();
            contributors.Clear();
        }

        if (selectedOption == "gitCommits")
        {
            isLoadingResults = true;
            contributors = new List<(string Name, string Summary)>();
            trendData = null;
            analysisResultHtml = "gitCommits";
            StateHasChanged();
            
            try
            {
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("scrollToBottom", true);
            }
            catch { /* Ignore scroll errors */ }

            _ = Task.Run(async () =>
            {
                try
                {
                    if (selectedView == "trends")
                    {
                        CommitQueryOptions commitQueryOptions = GetCommitQueryOptions();

                        commitCollection = await GitCommitMetrics.GetCommitsAsync(
                            commitQueryOptions.OrganizationName,
                            commitQueryOptions.ProjectName,
                            commitQueryOptions.GitRepositoryName,
                            commitQueryOptions.TargetBranchName,
                            commitQueryOptions.StartDateTime ?? DateTime.UtcNow.AddDays(-30),
                            commitQueryOptions.EndDateTime ?? DateTime.UtcNow);

                        if (commitCollection?.value != null && commitCollection.value.Any())
                        {
                            await InvokeAsync(() =>
                            {
                                trendProgressTotal = commitCollection.value.Count;
                                trendProgressCurrent = 0;
                                trendProgressPhase = "Retrieving commit details";
                                StateHasChanged();
                            });

                            var gitCommitCollection = await GitCommitMetrics.GetCommitLineDetailsAsync(
                                commitQueryOptions.OrganizationName,
                                commitQueryOptions.ProjectName,
                                commitQueryOptions.GitRepositoryName,
                                commitQueryOptions.TargetBranchName,
                                commitCollection,
                                async (phase, current, total) =>
                                {
                                    await InvokeAsync(() =>
                                    {
                                        trendProgressPhase = phase;
                                        trendProgressCurrent = current;
                                        trendProgressTotal = total;
                                        StateHasChanged();
                                    });
                                });

                            await InvokeAsync(() =>
                            {
                                trendData = BuildTrendData(gitCommitCollection!);
                                trendProgressTotal = 0;
                                isLoadingResults = false;
                                StateHasChanged();
                            });
                        }
                        else
                        {
                            await InvokeAsync(() =>
                            {
                                trendData = new List<CommitTrendDataPoint>();
                                isLoadingResults = false;
                                StateHasChanged();
                            });
                        }
                    }
                    else
                    {
                        var results = await GetCommitCollection();
                        await InvokeAsync(() =>
                        {
                            contributors = results;
                            isLoadingResults = false;
                            StateHasChanged();
                        });
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading commits: {ex.Message}");
                    await InvokeAsync(() =>
                    {
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
            });
        }
        else if (selectedOption == "workItems")
        {
            isLoadingResults = true;
            contributors = new List<(string Name, string Summary)>();
            analysisResultHtml = "workItems"; // Flag to render RenderWorkItemsResults with loading state
            StateHasChanged();
            
            // Scroll to bottom to show loading indicator
            try
            {
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("scrollToBottom", true);
            }
            catch { /* Ignore scroll errors */ }

            // Run the API call in background
            _ = Task.Run(async () =>
            {
                try
                {
                    var results = await GetWorkItemCollection();
                    await InvokeAsync(() =>
                    {
                        contributors = results;
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading work items: {ex.Message}");
                    await InvokeAsync(() =>
                    {
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
            });
        }
        else if (selectedOption == "icmResolutions")
        {
            isLoadingResults = true;
            contributors = new List<(string Name, string Summary)>();
            analysisResultHtml = "icmResolutions";
            StateHasChanged();
            
            try
            {
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("scrollToBottom", true);
            }
            catch { }

            _ = Task.Run(async () =>
            {
                try
                {
                    var results = await GetIncidentCollection();
                    await InvokeAsync(() =>
                    {
                        contributors = results;
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading incidents: {ex.Message}");
                    await InvokeAsync(() =>
                    {
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
            });
        }
        else
        {
            analysisResultHtml = string.Empty;
            StateHasChanged();
        }
    }

