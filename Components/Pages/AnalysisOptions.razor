    private RenderFragment RenderManagerSelection() => __builder =>
    {
        <div class="manager-selection mb-4 p-3 rounded border">
            <h5 class="mb-3 fw-bold">👥 Manager Selection</h5>
            <div class="d-flex gap-2 align-items-start flex-wrap">
                <input type="text"
                       class="form-control manager-search-input"
                       placeholder="Type a manager's name or alias..."
                       @bind="managerSearchText"
                       @bind:event="oninput"
                       @onkeydown="@OnManagerSearchKeyDown" />
                <button class="btn btn-primary" @onclick="SearchManagersAsync" disabled="@isSearchingManagers">
                    @if (isSearchingManagers)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Searching...</span>
                    }
                    else
                    {
                        <span>🔍 Search</span>
                    }
                </button>
                <button type="button"
                        class="btn btn-primary"
                        @onclick="ClearManagerSelection">
                    🧹 Clear
                </button>
            </div>

            @if (!string.IsNullOrEmpty(teamsErrorMessage))
            {
                <div class="alert alert-warning mt-3 mb-0 py-2">@teamsErrorMessage</div>
