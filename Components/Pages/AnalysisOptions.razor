    private List<CommitTrendDataPoint> BuildTrendData(GitCommitCollection gitCommitCollection)
    {
        if (gitCommitCollection?.Value == null || !gitCommitCollection.Value.Any())
            return new List<CommitTrendDataPoint>();

        // Defensively deduplicate commits before aggregation.
        var uniqueCommits = gitCommitCollection.Value
            .GroupBy(c => string.IsNullOrWhiteSpace(c.CommitId)
                ? $"NO_ID|{c.CommitterDate:O}|{c.AuthorEmail}|{c.CommitterEmail}|{c.Comment}"
                : c.CommitId,
                StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();

#if DEBUG
        Console.WriteLine($"📈 Trend input commits: raw={gitCommitCollection.Value.Count}, unique={uniqueCommits.Count}");
#endif

        IEnumerable<IGrouping<string, GitCommit>> grouped;

        if (selectedTrendPeriod == "yearly")
        {
            grouped = uniqueCommits
                .GroupBy(c => c.CommitterDate.ToString("yyyy"))
                .OrderBy(g => g.Key);
        }
        else if (selectedTrendPeriod == "daily")
        {
            grouped = uniqueCommits
                .GroupBy(c => c.CommitterDate.ToString("yyyy-MM-dd"))
                .OrderBy(g => g.Key);
        }
        else
        {
            grouped = uniqueCommits
                .GroupBy(c => c.CommitterDate.ToString("yyyy-MM"))
                .OrderBy(g => g.Key);
        }

        return grouped.Select(g => new CommitTrendDataPoint
        {
            Period = g.Key,
            TotalCommits = g.Count(),
            TotalLinesAdded = g.Sum(c => c.AddedLines),
            TotalLinesDeleted = g.Sum(c => c.DeletedLines),
            ServiceLinesAdded = g.Sum(c => GetServiceLinesAdded(c)),
            ServiceLinesDeleted = g.Sum(c => GetServiceLinesDeleted(c)),
            TestLinesAdded = g.Sum(c => GetTestLinesAdded(c)),
            TestLinesDeleted = g.Sum(c => GetTestLinesDeleted(c))
        }).ToList();
    }

    private static bool IsTestFile(string filePath) =>
        filePath.IndexOf("test", StringComparison.OrdinalIgnoreCase) >= 0;

    private static int GetTestLinesAdded(GitCommit c) =>
        c.ChangedFilesAddedLineCounts?
            .Where(kvp => IsTestFile(kvp.Key))
            .Sum(kvp => kvp.Value) ?? 0;

    private static int GetTestLinesDeleted(GitCommit c) =>
        c.ChangedFilesDeletedLineCounts?
            .Where(kvp => IsTestFile(kvp.Key))
            .Sum(kvp => kvp.Value) ?? 0;

    private static int GetServiceLinesAdded(GitCommit c) =>
        c.ChangedFilesAddedLineCounts?
            .Where(kvp => !IsTestFile(kvp.Key))
            .Sum(kvp => kvp.Value) ?? 0;

    private static int GetServiceLinesDeleted(GitCommit c) =>
        c.ChangedFilesDeletedLineCounts?
            .Where(kvp => !IsTestFile(kvp.Key))
            .Sum(kvp => kvp.Value) ?? 0;

    private static string FormatServiceTestRatio(int serviceLines, int testLines)
    {
        if (serviceLines == 0 && testLines == 0)
        {
            return "0:0";
        }

        if (testLines == 0)
        {
            return "Inf";
        }

        double ratio = (double)serviceLines / testLines;
        return $"{ratio:F2}:1";
    }

    public class CommitTrendDataPoint
    {
        public string Period { get; set; } = "";
        public int TotalCommits { get; set; }
        public int TotalLinesAdded { get; set; }
        public int TotalLinesDeleted { get; set; }
        public int ServiceLinesAdded { get; set; }
        public int ServiceLinesDeleted { get; set; }
        public int TestLinesAdded { get; set; }
        public int TestLinesDeleted { get; set; }
    }
