    private Func<object, string> FormatCategoryAxisLabel => (value) =>
    {
        if (trendData == null || trendData.Count == 0) return value?.ToString() ?? "";
        var label = value?.ToString() ?? "";
        var index = trendData.FindIndex(d => d.Period == label);
        return (index >= 0 && index % 5 == 0) ? label : " ";
    };
    
