                                @onclick="@(() => SelectManager(user))">
                                <span>
                                    <span class="fw-bold">@user.displayName</span>
                                    @if (!string.IsNullOrEmpty(user.jobTitle))
                                    {
                                        <span class="text-muted small"> — @user.jobTitle</span>
                                    }
                                </span>
                                <span class="d-flex align-items-center gap-2">
                                    <span class="text-muted small">@(user.mail ?? user.userPrincipalName)</span>
                                    <button type="button"
                                            class="btn btn-primary btn-sm"
                                            @onclick="@(() => LoadOrgTreeForManagerAsync(user))"
                                            @onclick:stopPropagation="true"
                                            disabled="@isLoadingOrgTree">
                                        Fetch Reports
                                    </button>
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            }
            else if (selectedManager == null && !isSearchingManagers && hasSearchedManagers)
            {
                <div class="text-muted mt-3 mb-0">No matching users found.</div>
            }

            @if (selectedManager != null)
            {
                <div class="selected-manager-chip mt-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <span class="fw-bold">@selectedManager.displayName</span>
                        @if (!string.IsNullOrEmpty(selectedManager.jobTitle))
                        {
                            <span class="text-muted small"> — @selectedManager.jobTitle</span>
                        }
                        <span class="text-muted small d-block">@(selectedManager.mail ?? selectedManager.userPrincipalName)</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="LoadOrgTreeAsync" disabled="@isLoadingOrgTree">
                            @if (isLoadingOrgTree)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Fetching...</span>
                            }
                            else
                            {
                                <span>Fetch Reports</span>
                            }
                        </button>
                    </div>
                </div>
            }

            @if (orgTreeRoot != null)
            {
                <div class="org-tree-container mt-3">
                    <div class="text-muted small mb-2">@orgTreeMemberCount report(s) under @orgTreeRoot.DisplayName</div>
                    <ul class="org-tree">
                        @RenderOrgTree(orgTreeRoot, true)
                    </ul>
                </div>
            }
        </div>
    };

    private RenderFragment RenderOrgTree(OrgMember node, bool isRoot) => __builder =>
    {
        var nodeId = node.Id ?? node.DisplayName ?? Guid.NewGuid().ToString();
        var isExpanded = expandedOrgNodes.Contains(nodeId);

        <li class="org-tree-node">
            <div class="org-tree-row d-flex align-items-center">
                @if (node.HasReports)
                {
                    <button class="btn btn-sm org-tree-toggle" @onclick="@(() => ToggleOrgNode(nodeId))" type="button">
                        @(isExpanded ? "▼" : "▶")
                    </button>
                }
                else
                {
                    <span class="org-tree-leaf-spacer"></span>
                }
                <div class="org-tree-info">
                    <span class="fw-bold">@node.DisplayName</span>
                    @if (!string.IsNullOrEmpty(node.JobTitle))
                    {
                        <span class="text-muted small"> — @node.JobTitle</span>
                    }
                    @if (node.HasReports)
                    {
                        <span class="badge bg-secondary ms-2">@node.Reports.Count (@CountReports(node))</span>
                    }
                    <span class="text-muted small d-block">@(node.Mail ?? node.UserPrincipalName)</span>
                </div>
            </div>
            @if (node.HasReports && isExpanded)
            {
                <ul class="org-tree">
                    @foreach (var child in node.Reports)
                    {
                        @RenderOrgTree(child, false)
                    }
                </ul>
            }
        </li>
    };

    private bool hasSearchedManagers = false;

    private async Task OnManagerSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchManagersAsync();
        }
    }

    private async Task SearchManagersAsync()
    {
        if (string.IsNullOrWhiteSpace(managerSearchText))
        {
            return;
        }

        var operationVersion = ++managerOperationVersion;
        isSearchingManagers = true;
        teamsErrorMessage = null;
        selectedManager = null;
        orgTreeRoot = null;
        managerSearchResults = new List<GraphUser>();
        StateHasChanged();

        try
        {
            var results = await TeamHierarchyMetrics.SearchManagersAsync(managerSearchText);
            if (operationVersion != managerOperationVersion)
            {
                return;
            }

            managerSearchResults = results;
            if (!results.Any())
            {
                teamsErrorMessage = null;
            }
        }
        catch (Exception ex)
        {
            if (operationVersion == managerOperationVersion)
            {
                teamsErrorMessage = $"Failed to search managers: {ex.Message}";
            }
        }
        finally
        {
            if (operationVersion == managerOperationVersion)
            {
                hasSearchedManagers = true;
                isSearchingManagers = false;
                StateHasChanged();
            }
        }
    }

    private void SelectManager(GraphUser user)
    {
        selectedManager = user;
        managerSearchResults = new List<GraphUser>();
        orgTreeRoot = null;
        expandedOrgNodes.Clear();
        teamsErrorMessage = null;
    }

    private async Task LoadOrgTreeForManagerAsync(GraphUser manager)
    {
        SelectManager(manager);
        await LoadOrgTreeAsync();
    }

    private void ClearManagerSelection()
    {
        managerOperationVersion++;
        managerSearchText = string.Empty;
        managerSearchResults = new List<GraphUser>();
        selectedManager = null;
        orgTreeRoot = null;
        expandedOrgNodes.Clear();
        isSearchingManagers = false;
        isLoadingOrgTree = false;
        teamsErrorMessage = null;
        hasSearchedManagers = false;
        orgTreeMemberCount = 0;
    }

    private async Task LoadOrgTreeAsync()
    {
        if (selectedManager == null)
        {
            return;
        }

        var operationVersion = ++managerOperationVersion;
        isLoadingOrgTree = true;
        teamsErrorMessage = null;
        orgTreeRoot = null;
        StateHasChanged();

        try
        {
            var root = await TeamHierarchyMetrics.GetReportsHierarchyAsync(selectedManager);
            if (operationVersion != managerOperationVersion)
            {
                return;
            }

            RemoveServiceAccounts(root);
            orgTreeRoot = root;
            if (root == null)
            {
                teamsErrorMessage = "Could not retrieve reports. Ensure the app has Microsoft Graph permissions (User.Read.All or Directory.Read.All).";
            }
            else
            {
                orgTreeMemberCount = CountReports(root);
                expandedOrgNodes.Clear();
                if (!string.IsNullOrEmpty(root.Id))
                {
                    expandedOrgNodes.Add(root.Id);
                }
            }
        }
        catch (Exception ex)
        {
            if (operationVersion == managerOperationVersion)
            {
                teamsErrorMessage = $"Failed to fetch reports: {ex.Message}";
            }
        }
        finally
        {
            if (operationVersion == managerOperationVersion)
            {
                isLoadingOrgTree = false;
                StateHasChanged();
            }
        }
    }

    private static void RemoveServiceAccounts(OrgMember? node)
    {
        if (node == null)
        {
            return;
        }

        var visibleReports = new List<OrgMember>();
        foreach (var report in node.Reports)
        {
            RemoveServiceAccounts(report);

            var email = report.Mail ?? report.UserPrincipalName;
            if (email?.StartsWith("sc-", StringComparison.OrdinalIgnoreCase) == true)
            {
                visibleReports.AddRange(report.Reports);
            }
            else
            {
                visibleReports.Add(report);
            }
        }

        node.Reports = visibleReports;
    }

    private void ToggleOrgNode(string nodeId)
    {
        if (!expandedOrgNodes.Add(nodeId))
        {
            expandedOrgNodes.Remove(nodeId);
        }
    }

    private static int CountReports(OrgMember node)
    {
        int count = node.Reports.Count;
        foreach (var child in node.Reports)
        {
            count += CountReports(child);
        }
        return count;
    }

    private void OnTeamChanged(ChangeEventArgs e)
    {
        selectedTeam = e.Value?.ToString() ?? "Cosmos on Azure Job Service";
        selectedAreaPath = GetAreaPathForTeam();
        SyncSelectedTeamCombinations();
    }

    private void OnSelectedTeamCombinationsChanged(object value)
    {
        selectedTeams = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var isFirstCombination = true;

        foreach (var combination in selectedTeamCombinations ?? Enumerable.Empty<string>())
        {
            var parts = combination.Split(TeamCombinationSeparator, 4, StringSplitOptions.None);
            if (parts.Length != 4)
            {
                continue;
            }

            selectedTeams.Add(parts[2]);
            if (isFirstCombination)
            {
                selectedOrganization = parts[0];
                selectedProject = parts[1];
                selectedTeam = parts[2];
                selectedAreaPath = parts[3];
                isFirstCombination = false;
            }
        }
    }

    private void OnOrganizationChanged(ChangeEventArgs e)
    {
        selectedOrganization = e.Value?.ToString() ?? "msdata";
        selectedProject = selectedOrganization == "msdata" ? "A365" : "MWC";
        if (selectedProject == "A365")
        {
            selectedTeam = "Cosmos on Azure Job Service";
            selectedGitRepository = "BBC-VHD";
            selectedAreaPath = GetAreaPathForTeam();
        }
        else if (selectedProject == "MWC")
        {
            selectedGitRepository = "workload-sparkcore";
        }
        selectedTargetBranch = GetTargetBranch();
        SyncSelectedTeamCombinations();
    }

    private void OnProjectChanged(ChangeEventArgs e)
    {
        selectedProject = e.Value?.ToString() ?? "A365";
        if (selectedProject == "A365")
        {
            selectedTeam = "Cosmos on Azure Job Service";
            selectedGitRepository = "BBC-VHD";
            selectedAreaPath = GetAreaPathForTeam();
        }
        else if (selectedProject == "HDInsight")
        {
            selectedGitRepository = "wildfire-livy";
        }
        else if (selectedProject == "MWC")
        {
            selectedGitRepository = "workload-sparkcore";
        }
        selectedTargetBranch = GetTargetBranch();
        SyncSelectedTeamCombinations();
    }

    private void SyncSelectedTeamCombinations()
    {
        var combination = BuildTeamCombination(selectedOrganization, selectedProject, selectedTeam, selectedAreaPath);
        if (teamCombinationOptions.Contains(combination, StringComparer.OrdinalIgnoreCase))
        {
            selectedTeamCombinations = new List<string> { combination };
            selectedTeams = new HashSet<string>(new[] { selectedTeam }, StringComparer.OrdinalIgnoreCase);
        }
        else
        {
            selectedTeamCombinations = new List<string>();
            selectedTeams.Clear();
        }
    }

    private static string BuildTeamCombination(string organization, string project, string team, string areaPath)
    {
        return $"{organization}{TeamCombinationSeparator}{project}{TeamCombinationSeparator}{team}{TeamCombinationSeparator}{areaPath}";
    }

    private void OnGitRepositoryChanged(ChangeEventArgs e)
    {
        selectedGitRepository = e.Value?.ToString() ?? "BBC-VHD";
        selectedTargetBranch = GetTargetBranch();
