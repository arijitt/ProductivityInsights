    private string BuildAnalysisParametersHtml()
    {
        var html = new System.Text.StringBuilder();
        html.Append("<div class='parameter-section'>");
        html.Append($"<h6 class='fw-bold text-primary mb-3'>Analysis Type: {GetAnalysisTypeName()}</h6>");
        
        html.Append("<table class='table table-sm table-bordered'>");
        html.Append("<tbody>");
        
        // Common parameters
        if (selectedOption != "icmResolutions")
        {
            html.Append($"<tr><td class='fw-bold' style='width: 200px;'>Organization</td><td>{selectedOrganization}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Project</td><td>{selectedProject}</td></tr>");
        }
        
        // Work Items specific
        if (selectedOption == "workItems")
        {
            if (selectedProject == "A365")
            {
                html.Append($"<tr><td class='fw-bold'>Team Name</td><td>{selectedTeam}</td></tr>");
            }
            html.Append($"<tr><td class='fw-bold'>Area Path</td><td>{selectedAreaPath}</td></tr>");
        }
        
        // Git Commits specific
        if (selectedOption == "gitCommits")
        {
            html.Append($"<tr><td class='fw-bold'>Git Repository</td><td>{selectedGitRepository}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Target Branch</td><td>{selectedTargetBranch}</td></tr>");
        }
        
        // ICM Resolutions specific
        if (selectedOption == "icmResolutions")
        {
            html.Append($"<tr><td class='fw-bold'>Owning Team</td><td>{selectedOwningTeam}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Key Vault URL</td><td>{selectedKeyVaultUrl}</td></tr>");
            html.Append($"<tr><td class='fw-bold'>Certificate Name</td><td>{selectedKeyVaultCertificateName}</td></tr>");
        }
        
        // Date range (common for all)
        html.Append($"<tr><td class='fw-bold'>Start Date Time</td><td>{startDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "Not set"}</td></tr>");
        html.Append($"<tr><td class='fw-bold'>End Date Time</td><td>{endDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "Not set"}</td></tr>");
        
        html.Append("</tbody></table>");
        html.Append("</div>");
        
        return html.ToString();
    }

    private string GetAnalysisTypeName()
    {
        return selectedOption switch
        {
            "workItems" => "Work Items Analysis",
            "gitCommits" => "Git Commits Analysis",
            "icmResolutions" => "ICM Resolutions Analysis",
            _ => "Unknown Analysis"
        };
    }

    private async Task CloseModal()
    {
        await JSRuntime.InvokeVoidAsync("hideModal", "analysisModal");
    }

    private void CloseAnalysisResults()
    {
        analysisResultHtml = string.Empty;
        expandedRows.Clear();
        contributorDetails.Clear();
    }

    private async Task ConfirmAnalysis()
    {
        await JSRuntime.InvokeVoidAsync("hideModal", "analysisModal");

        if (selectedOption == "gitCommits")
        {
            isLoadingResults = true;
            contributors = new List<(string Name, string Summary)>();
            analysisResultHtml = "gitCommits"; // Flag to render RenderGitCommitsResults with loading state
            StateHasChanged();
            
            // Scroll to bottom to show loading indicator
            try
            {
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("scrollToBottom", true);
            }
            catch { /* Ignore scroll errors */ }

            // Run the API call in background
            _ = Task.Run(async () =>
            {
                try
                {
                    var results = await GetCommitCollection();
                    await InvokeAsync(() =>
                    {
                        contributors = results;
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading commits: {ex.Message}");
                    await InvokeAsync(() =>
                    {
                        isLoadingResults = false;
                        StateHasChanged();
                    });
                }
            });
        }
        else
        {
            analysisResultHtml = string.Empty;
            StateHasChanged();
        }
    }

    private RenderFragment RenderGitCommitsResults() => __builder =>
    {
        
        <div class="table-responsive">
            <table class="table table-bordered table-sm mb-0">
                <thead>
                    <tr>
                        <th colspan="3" class="text-center fw-bold table-title-header">
                            Code Contribution Summary for '@selectedOrganization\@selectedProject\@selectedGitRepository\@selectedTargetBranch' Branch
                        </th>
                    </tr>
                    <tr>
                        <th scope="col">Contributor</th>
                        <th scope="col">Summary</th>
                        <th scope="col" style="width: 50px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoadingResults)
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <div class="mt-3 fw-semibold">Loading commit data...</div>
                            </td>
                        </tr>
                    }
                    else if (!contributors.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                No commits found for the selected criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var contributor in contributors)
                    {
                        var isExpanded = expandedRows.Contains(contributor.Name);
                        <tr class="contributor-row">
                            <td class="fw-normal">@contributor.Name</td>
                            <td>@contributor.Summary</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-link expand-btn" @onclick="() => ToggleRow(contributor.Name)">
                                    <span class="@(isExpanded ? "expanded" : "")">@(isExpanded ? "−" : "+")</span>
                                </button>
                            </td>
                        </tr>
                        @if (isExpanded)
                        {
                            <tr class="details-row">
                                <td colspan="3">
                                    <div class="commit-details">
                                        @if (contributorDetails.ContainsKey(contributor.Name))
                                        {
                                            @((MarkupString)contributorDetails[contributor.Name])
                                        }
                                        else
                                        {
                                            <div class="text-center py-3">
                                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                                <div class="mt-2">Loading commit details...</div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    }
                </tbody>
            </table>
        </div>
    };

    private async Task ToggleRow(string contributorName)
    {
        if (expandedRows.Contains(contributorName))
        {
            expandedRows.Remove(contributorName);
        }
        else
        {
            expandedRows.Add(contributorName);
            
            // Load details if not already loaded
            if (!contributorDetails.ContainsKey(contributorName))
            {
                StateHasChanged(); // Show loading state
                var details = await GetContributionDetails(contributorName);
                contributorDetails[contributorName] = details;
                StateHasChanged(); // Show loaded details
            }
        }
    }

    private async Task<List<(string Name, string Summary)>> GetCommitCollection()
    {
        CommitQueryOptions commitQueryOptions = GetCommitQueryOptions();

        commitCollection = await GitCommitMetrics.GetCommitsAsync(
            commitQueryOptions.OrganizationName,
            commitQueryOptions.ProjectName,
            commitQueryOptions.GitRepositoryName,
            commitQueryOptions.TargetBranchName,
            commitQueryOptions.StartDateTime ?? DateTime.UtcNow.AddDays(-30),
            commitQueryOptions.EndDateTime ?? DateTime.UtcNow);

        if (commitCollection?.value == null || !commitCollection.value.Any())
        {
            return new List<(string Name, string Summary)>();
        }

        // Group commits by author/committer name and aggregate
        var commitStatistics = commitCollection.value
            .GroupBy(c => c.committer?.name ?? c.author?.name ?? "Unknown")
            .Select(g => new
            {
                Name = g.Key,
                CommitCount = g.Count(),
                TotalAdded = g.Sum(c => c.changeCounts?.Add ?? 0),
                TotalDeleted = g.Sum(c => c.changeCounts?.Delete ?? 0),
                TotalEdited = g.Sum(c => c.changeCounts?.Edit ?? 0)
            })
            .OrderByDescending(x => x.CommitCount)
            .ThenByDescending(x => x.TotalAdded + x.TotalDeleted + x.TotalEdited)
            .Select(x => (
                Name: x.Name,
                Summary: $"{x.CommitCount} commit{(x.CommitCount != 1 ? "s" : "")} (+{x.TotalAdded}/-{x.TotalDeleted}/{x.TotalEdited} files)"
            ))
            .ToList();

        return commitStatistics;
    }

    private async Task<string> GetContributionDetails(string contributorName)
    {
        if (commitCollection?.value == null || !commitCollection.value.Any())
        {
            return "<div class='commit-entry'><div class='commit-info'><em>No commits found.</em></div></div>";
        }

        var contributorCommits = this.commitCollection.value
           .Where(c => (c.committer?.name ?? c.author?.name ?? "Unknown") == contributorName)
           .OrderByDescending(c => c.committer?.date ?? c.author?.date ?? DateTime.MinValue)
           .ToList();

        if (!contributorCommits.Any())
        {
            return $"<div class='commit-entry'><div class='commit-info'><em>No commits found for {contributorName}.</em></div></div>";
        }

        CommitCollection? contributorCommitCollection = new CommitCollection()
        {
            count = contributorCommits.Count,
            value = contributorCommits
        };

        CommitQueryOptions commitQueryOptions = GetCommitQueryOptions();

        GitCommitCollection? gitCommitCollection = await GitCommitMetrics.GetCommitDetailsAsync(
            commitQueryOptions.OrganizationName,
            commitQueryOptions.ProjectName,
            commitQueryOptions.GitRepositoryName,
            commitQueryOptions.TargetBranchName,
            contributorCommitCollection);

        if (gitCommitCollection?.Value == null || !gitCommitCollection.Value.Any())
        {
            return $"<div class='commit-entry'><div class='commit-info'><em>No detailed commit information available for {contributorName}.</em></div></div>";
        }

        var details = new System.Text.StringBuilder();

        // Calculate totals for contributor
        var totalAddedLines = gitCommitCollection.Value.Sum(c => c.AddedLines);
        var totalDeletedLines = gitCommitCollection.Value.Sum(c => c.DeletedLines);
        var totalFilesChanged = gitCommitCollection.Value.Sum(c => c.ChangedFilesCommitTypes.Count);
        var totalCommits = gitCommitCollection.Value.Count;

        // Add contributor summary header
        details.Append("<div class='contributor-summary mb-3 p-3' style='background-color: var(--bs-secondary-bg); border-left: 4px solid var(--bs-primary); border-radius: 4px;'>")
               .Append($"<h6 class='fw-bold mb-2'>📊 Summary for {contributorName}</h6>")
               .Append($"<div><strong>Total Commits:</strong> {totalCommits}</div>")
               .Append($"<div><strong>Total Lines Added:</strong> <span class='text-success'>+{totalAddedLines}</span></div>")
               .Append($"<div><strong>Total Lines Deleted:</strong> <span class='text-danger'>-{totalDeletedLines}</span></div>")
               .Append($"<div><strong>Total Files Changed:</strong> {totalFilesChanged}</div>")
               .Append("</div>");

        foreach (var gitCommit in gitCommitCollection.Value)
        {
            var commitDate = gitCommit.CommitterDate;
            var authorName = gitCommit.AuthorName ?? "Unknown";
            var authorEmail = gitCommit.AuthorEmail ?? "";
            var committerName = gitCommit.CommitterName ?? "Unknown";
            var committerEmail = gitCommit.CommitterEmail ?? "";
            var commitMessage = gitCommit.Comment ?? "No message";
            var commitIdShort = gitCommit.CommitId?.Substring(0, Math.Min(8, gitCommit.CommitId.Length)) ?? "Unknown";
            
            var addedLines = gitCommit.AddedLines;
            var deletedLines = gitCommit.DeletedLines;
            var filesChanged = gitCommit.ChangedFilesCommitTypes.Count;

            details.Append("<div class='commit-entry'>")
                   .Append($"<div class='commit-header'>🔄 Commit: <span class='commit-hash'>{commitIdShort}...</span></div>")
                   .Append($"<div class='commit-info'><strong>Author:</strong> {authorName}");
            
            if (!string.IsNullOrEmpty(authorEmail))
            {
                details.Append($" &lt;{authorEmail}&gt;");
            }
            
            details.Append($"<div class='commit-info'><strong>Committer:</strong> {committerName}");

            if (!string.IsNullOrEmpty(committerEmail))
            {
                details.Append($" &lt;{committerEmail}&gt;");
            }

            details.Append("</div>")
                   .Append($"<div class='commit-info'><strong>Date:</strong> {commitDate:yyyy-MM-dd HH:mm:ss}</div>")
                   .Append($"<div class='commit-info'><strong>Message:</strong> {System.Web.HttpUtility.HtmlEncode(commitMessage)}</div>")
                   .Append($"<div class='commit-stats'>📊 Line Changes: <span class='text-success'>+{addedLines} additions</span>, <span class='text-danger'>-{deletedLines} deletions</span></div>")
                   .Append($"<div class='commit-info'><strong>📁 Files Changed:</strong> {filesChanged}</div>");

            // Show changed files details
            if (gitCommit.ChangedFilesCommitTypes.Any())
            {
                details.Append("<div class='commit-files'><strong>Changed Files:</strong>");
                foreach (var file in gitCommit.ChangedFilesCommitTypes.Take(10)) // Limit to first 10 files
                {
                    var filePath = file.Key;
                    var changeType = file.Value;
                    
                    // Get per-file line counts
                    gitCommit.ChangedFilesAddedLineCounts.TryGetValue(filePath, out var fileAdded);
                    gitCommit.ChangedFilesDeletedLineCounts.TryGetValue(filePath, out var fileDeleted);
                    
                    details.Append($"<div class='file-item'>📄 {System.Web.HttpUtility.HtmlEncode(filePath)} [{changeType}] (+{fileAdded}/-{fileDeleted})</div>");
                }
                
                if (gitCommit.ChangedFilesCommitTypes.Count > 10)
                {
                    details.Append($"<div class='file-item'><em>... and {gitCommit.ChangedFilesCommitTypes.Count - 10} more files</em></div>");
                }
                
                details.Append("</div>");
            }

            if (!string.IsNullOrEmpty(gitCommit.RemoteUrl))
            {
                details.Append($"<div class='commit-info'>🌐 <strong>URL:</strong> <a href='{gitCommit.RemoteUrl}' target='_blank'>View Commit</a></div>");
            }

            details.Append("</div>");
            
            // Add separator between commits except for the last one
            if (gitCommit != gitCommitCollection.Value.Last())
            {
                details.Append("<hr class='commit-separator'/>");
            }
        }

        return details.ToString();
    }

    private string GetContributionOverview(string contributorName)
    {
        if (commitCollection?.value == null || !commitCollection.value.Any())
        {
            return "<div class='commit-entry'><div class='commit-info'><em>No commits found.</em></div></div>";
        }

        // Filter commits for this specific contributor
        var contributorCommits = this.commitCollection.value
            .Where(c => (c.committer?.name ?? c.author?.name ?? "Unknown") == contributorName)
            .OrderByDescending(c => c.committer?.date ?? c.author?.date ?? DateTime.MinValue)
            .ToList();

        if (!contributorCommits.Any())
        {
            return $"<div class='commit-entry'><div class='commit-info'><em>No commits found for {contributorName}.</em></div></div>";
        }

        var details = new System.Text.StringBuilder();

        foreach (var commit in contributorCommits)
        {
            var commitDate = commit.committer?.date ?? commit.author?.date ?? DateTime.MinValue;
            var authorName = commit.author?.name ?? "Unknown";
            var authorEmail = commit.author?.email ?? "";
            var commitMessage = commit.comment ?? "No message";
            var commitIdShort = commit.commitId?.Substring(0, Math.Min(8, commit.commitId.Length)) ?? "Unknown";
            
            var additions = commit.changeCounts?.Add ?? 0;
            var deletions = commit.changeCounts?.Delete ?? 0;
            var edits = commit.changeCounts?.Edit ?? 0;

            details.Append("<div class='commit-entry'>")
                   .Append($"<div class='commit-header'>🔄 Commit: <span class='commit-hash'>{commitIdShort}...</span></div>")
                   .Append($"<div class='commit-info'><strong>Author:</strong> {authorName}");
            
            if (!string.IsNullOrEmpty(authorEmail))
            {
                details.Append($" &lt;{authorEmail}&gt;");
            }
            
            details.Append("</div>")
                   .Append($"<div class='commit-info'><strong>Date:</strong> {commitDate:yyyy-MM-dd HH:mm:ss}</div>")
                   .Append($"<div class='commit-info'><strong>Message:</strong> {System.Web.HttpUtility.HtmlEncode(commitMessage)}</div>")
                   .Append($"<div class='commit-stats'>📊 Changes: <span class='text-success'>+{additions} additions</span>, <span class='text-danger'>-{deletions} deletions</span>, <span class='text-info'>{edits} files edited</span></div>");

            if (!string.IsNullOrEmpty(commit.remoteUrl))
            {
                details.Append($"<div class='commit-info'>🌐 <strong>URL:</strong> <a href='{commit.remoteUrl}' target='_blank'>View Commit</a></div>");
            }

            details.Append("</div>");
            
            // Add separator between commits except for the last one
            if (commit != contributorCommits.Last())
            {
                details.Append("<hr class='commit-separator'/>");
            }
        }

        return details.ToString();
    }

