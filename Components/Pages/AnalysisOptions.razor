@page "/"
@using ProductivityInsights.Metrics
@using ProductivityInsights.Models
@using ProductivityInsights.Models.CommitChanges
@using ProductivityInsights.Models.Incidents
@using ProductivityInsights.Models.Teams
@using ProductivityInsights.Models.WorkItems
@using ProductivityInsights.Models.WorkItems.HistoryCollection
@using ProductivityInsights.Options
@using ProductivityInsights.Utilities
@using System.Security.Cryptography.X509Certificates
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject ProductivityInsights.Services.ThemeService ThemeService
@implements IAsyncDisposable

<PageTitle>Productivity Overview</PageTitle>

<div class="container mt-4">
    <h1 class="text-center mb-4 fw-bold">Productivity Insights</h1>

    <div class="content-wrapper">
        <!-- Vertical Sidebar -->
        <ul class="nav nav-tabs nav-tabs-vertical shadow-sm" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link fs-5 fw-bold @(selectedView == "details" ? "active" : "")" 
                        type="button" 
                        @onclick="@(() => selectedView = "details")">
                    Details
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fs-5 fw-bold @(selectedView == "trends" ? "active" : "")" 
                        type="button" 
                        @onclick="@(() => selectedView = "trends")">
                    Trends
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fs-5 fw-bold @(selectedView == "teams" ? "active" : "")" 
                        type="button" 
                        @onclick="@(() => selectedView = "teams")">
                    Teams
                </button>
            </li>
        </ul>

        <!-- Main Content -->
        <div class="main-panel">
            <!-- Horizontal Tabs -->
            <ul class="nav nav-tabs mb-0 shadow-sm" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link fs-5 fw-bold @(selectedOption == "workItems" ? "active" : "")" 
                            type="button" 
                            @onclick="@(() => OnOptionSelected("workItems"))">
                        Work Items
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fs-5 fw-bold @(selectedOption == "gitCommits" ? "active" : "")" 
                            type="button" 
                            @onclick="@(() => OnOptionSelected("gitCommits"))">
                        Git Commits
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fs-5 fw-bold @(selectedOption == "icmResolutions" ? "active" : "")" 
                            type="button" 
                            @onclick="@(() => OnOptionSelected("icmResolutions"))">
                        ICM Resolutions
                    </button>
                </li>
            </ul>

            <div class="tab-content shadow-sm border border-top-0 rounded-bottom p-4">
                <div class="tab-pane fade @(selectedOption == "workItems" ? "show active" : "")" role="tabpanel">
                    @if (selectedOption == "workItems")
                    {
                        @if (selectedView == "teams")
                        {
                            @RenderManagerSelection()
                        }
                        <h4 class="mb-4">Work Items Analysis</h4>
                        @RenderAnalysisForm()
                    }
                </div>
                <div class="tab-pane fade @(selectedOption == "gitCommits" ? "show active" : "")" role="tabpanel">
                    @if (selectedOption == "gitCommits")
                    {
                        @if (selectedView == "teams")
                        {
                            @RenderManagerSelection()
                        }
                        <h4 class="mb-4">Git Commits Analysis</h4>
                        @RenderGitCommitsForm()
                    }
                </div>
                <div class="tab-pane fade @(selectedOption == "icmResolutions" ? "show active" : "")" role="tabpanel">
                    @if (selectedOption == "icmResolutions")
                    {
                        @if (selectedView == "teams")
                        {
                            @RenderManagerSelection()
                        }
                        <h4 class="mb-4">ICM Resolutions Analysis</h4>
                        @RenderICMAnalysisForm()
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(analysisResultHtml))
            {
                <div class="analysis-results" id="analysisResultsContainer">
                    <button class="btn btn-sm analysis-close-btn" @onclick="CloseAnalysisResults" aria-label="Close results">
                        <span aria-hidden="true">×</span>
                    </button>
                    <button class="btn btn-sm analysis-pdf-btn"
                            @onclick="DownloadAsPdf"
                            disabled="@isGeneratingPdf"
                            style="position: absolute; top: 1rem; right: calc(3rem + 32px); z-index: 10; padding-bottom: 0.5rem; display: inline-flex; align-items: center; justify-content: center;">
                        @if (isGeneratingPdf)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Generating...</span>
                        }
                        else
                        {
                            <span>📥 PDF</span>
                        }
                    </button>
                    @if (selectedView == "details" || selectedView == "teams")
                    {
                        <div style="margin-top: 2.5rem;">
                        @if (selectedOption == "gitCommits")
                        {
                            @RenderGitCommitsResults()
                        }
                        else if (selectedOption == "workItems")
                        {
                            @RenderWorkItemsResults()
                        }
                        else if (selectedOption == "icmResolutions")
                        {
                            @RenderICMIncidentsResults()
                        }
                        else
                        {
                            @((MarkupString)analysisResultHtml)
                        }
                        </div>
                    }
                    else if (selectedView == "trends")
                    {
                        @if (selectedOption == "gitCommits")
                        {
                            @RenderGitCommitsTrendChart()
                        }
                        else
                        {
                            <div class="trends-placeholder">
                                <div class="trends-icon">📈</div>
                                <h4>Trend Graphs</h4>
                                <p class="text-muted">@(char.ToUpper(selectedTrendPeriod[0]) + selectedTrendPeriod.Substring(1)) trend visualization coming soon...</p>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal for showing analysis parameters -->
<div class="modal fade" id="analysisModal" tabindex="-1" aria-labelledby="analysisModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="analysisModalLabel">Analysis Parameters</h5>
                <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close">
                    <span aria-hidden="true">✕</span>
                </button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(analysisParameters))
                {
                    <div class="analysis-params">
                        @((MarkupString)analysisParameters)
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="ConfirmAnalysis">Confirm & Run</button>
            </div>
        </div>
    </div>
</div>

@code {

    private string ChartGridLineColor => ThemeService.IsDarkMode ? "rgba(148,163,184,0.2)" : "rgba(0,0,0,0.15)";
    private string ChartContainerBackground => ThemeService.IsDarkMode ? "rgba(30, 41, 59, 0.45)" : "rgba(255, 255, 255, 0.35)";
    private string ChartContainerBorder => ThemeService.IsDarkMode ? "1px solid rgba(148, 163, 184, 0.2)" : "1px solid var(--bs-border-color, #dee2e6)";
    private bool chartThemeKey = false;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        chartThemeKey = !chartThemeKey;
        InvokeAsync(StateHasChanged);
    }

    private IJSObjectReference? _jsModule;

    private async Task<IJSObjectReference> GetJsModule()
    {
        _jsModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./theme.module.js");
        return _jsModule;
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
        if (_jsModule is not null)
        {
            await _jsModule.DisposeAsync();
        }
    }

    private RenderFragment RenderAnalysisForm() => __builder =>
    {
        @if (selectedView == "teams")
        {
