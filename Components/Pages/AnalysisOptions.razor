    private void OnOptionSelected(string option)
    {
        selectedOption = option;
    }

    private void OnOrganizationChanged(ChangeEventArgs e)
    {
        selectedOrganization = e.Value?.ToString() ?? "msdata";
        selectedProject = selectedOrganization == "msdata" ? "A365" : "MWC";
        if (selectedProject == "A365")
        {
            selectedTeam = "Cosmos on Azure Job Service";
            selectedGitRepository = "BBC-VHD";
        }
        else if (selectedProject == "MWC")
        {
            selectedGitRepository = "workload-sparkcore";
        }
    }

    private void OnProjectChanged(ChangeEventArgs e)
    {
        selectedProject = e.Value?.ToString() ?? "A365";
        if (selectedProject == "A365")
        {
            selectedTeam = "Cosmos on Azure Job Service";
            selectedGitRepository = "BBC-VHD";
        }
        else if (selectedProject == "HDInsight")
        {
            selectedGitRepository = "wildfire-livy";
        }
        else if (selectedProject == "MWC")
        {
            selectedGitRepository = "workload-sparkcore";
        }
        selectedTargetBranch = GetTargetBranch();
    }

    private void OnGitRepositoryChanged(ChangeEventArgs e)
    {
        selectedGitRepository = e.Value?.ToString() ?? "BBC-VHD";
        selectedTargetBranch = GetTargetBranch();
    }

    private string GetTargetBranch()
    {
        // Repositories that use "main" branch
        var mainBranchRepos = new[] { "workload-sparkcore", "workload-lakehouse", "workload-genericcomputemanager", 
                                      "workload-vpaas", "fabric-libraries", "fabric-spark-load-testing-suite", 
                                      "SparkRuntimeTSGs", "nebula" };
        
        // Repositories that use "master" branch
        var masterBranchRepos = new[] { "FeatureManagement", "aspaas", "wildfire-livy", 
                                        "BBC-VHD", "BBC-Probes", "marlin" };
        
        if (mainBranchRepos.Contains(selectedGitRepository))
        {
            return "main";
        }
        else if (masterBranchRepos.Contains(selectedGitRepository))
        {
            return "master";
        }
        
        return "main"; // default
    }

    private bool IsMainBranchApplicable()
    {
        var mainBranchRepos = new[] { "workload-sparkcore", "workload-lakehouse", "workload-genericcomputemanager", 
                                      "workload-vpaas", "fabric-libraries", "fabric-spark-load-testing-suite", 
                                      "SparkRuntimeTSGs", "nebula" };
        return mainBranchRepos.Contains(selectedGitRepository);
    }

    private bool IsMasterBranchApplicable()
    {
        var masterBranchRepos = new[] { "FeatureManagement", "aspaas", "wildfire-livy", 
                                        "BBC-VHD", "BBC-Probes", "marlin" };
        return masterBranchRepos.Contains(selectedGitRepository);
    }

